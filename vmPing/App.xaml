<Application x:Class="vmPing.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             StartupUri="Views/MainWindow.xaml"
             Startup="Application_Startup"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme colors. ThemeManager swaps this for Colors.Dark.xaml when the dark theme is on. -->
                <ResourceDictionary Source="Themes/Colors.Light.xaml"/>
                <ResourceDictionary Source="Themes/FocusVisualStyle.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/ValueConverters.xaml"/>
                <ResourceDictionary Source="Themes/ButtonStyle.xaml"/>
                <ResourceDictionary Source="Themes/DataGridStyle.xaml"/>
                <ResourceDictionary Source="Themes/ListBoxStyle.xaml"/>
                <ResourceDictionary Source="Themes/OptionsHeaderStyle.xaml"/>
                <ResourceDictionary Source="Themes/TabControlStyle.xaml"/>
                <ResourceDictionary Source="Themes/TextBoxStyle.xaml"/>
                <ResourceDictionary Source="Themes/ToolTipStyle.xaml"/>
                <ResourceDictionary Source="Themes/ComboBoxStyle.xaml"/>
                <ResourceDictionary Source="Themes/CheckBoxStyle.xaml"/>
                <ResourceDictionary Source="Themes/RadioButtonStyle.xaml"/>
                <ResourceDictionary Source="Themes/ScrollBarStyle.xaml"/>
                <ResourceDictionary Source="Themes/WindowChrome.xaml"/>
                <ResourceDictionary Source="Themes/MenuItemStyle.xaml"/>
                <ResourceDictionary Source="Themes/SliderStyle.xaml"/>
                <ResourceDictionary Source="Themes/ProbeTypeStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Application.Resources>
</Application>
