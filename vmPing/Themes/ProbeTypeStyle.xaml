<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:resource="clr-namespace:vmPing.Properties">

    <!-- Probe type label. Shown next to the hostname when a probe isn't a ping probe. -->
    <Style x:Key="ProbeTypeLabel" TargetType="{x:Type Label}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Foreground" Value="#1f4e8c"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Label}">
                    <Border Background="#dfe7f3"
                            CornerRadius="3"
                            Padding="5,1">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Type}" Value="Dns">
                <Setter Property="Visibility" Value="Visible"/>
                <Setter Property="Content" Value="{x:Static resource:Strings.ProbeType_DnsLabel}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="Traceroute">
                <Setter Property="Visibility" Value="Visible"/>
                <Setter Property="Content" Value="{x:Static resource:Strings.ProbeType_TracerouteLabel}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Probe type menu item -->
    <Style x:Key="ProbeTypeMenuItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Foreground" Value="#202020"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="8,4">
                        <DockPanel Width="160">
                            <!-- Shortcut key -->
                            <Border x:Name="KeyBorder"
                                    DockPanel.Dock="Right"
                                    MinWidth="18"
                                    BorderBrush="#c8c8c8"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="3,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="KeyText"
                                           Text="{TemplateBinding TextSearch.Text}"
                                           HorizontalAlignment="Center"
                                           FontSize="11"
                                           Foreground="#808080"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#e5eef9"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#c9def5"/>
                            <Setter TargetName="KeyBorder" Property="BorderBrush" Value="#a9bed5"/>
                            <Setter TargetName="KeyText" Property="Foreground" Value="#1f4e8c"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
