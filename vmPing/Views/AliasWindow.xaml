<Window x:Class="vmPing.Views.AliasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resource="clr-namespace:vmPing.Properties"
        Title="New Alias"
        UseLayoutRounding="True"
        Height="Auto"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="#f0f0f0"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="9">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                <Image Source="{DynamicResource icon.alias}" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,8,0"/>
                <TextBlock x:Name="Header"
                           Text="{x:Static resource:Strings.NewAlias_Header}"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource ResourceKey=OptionHeaderTextStyle}"/>
            </StackPanel>

            <!-- Alias TextBox-->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Border Width="50" Margin="0,0,15,0">
                    <TextBlock Text="{x:Static resource:Strings.NewAlias_Alias}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="#404040"
                               HorizontalAlignment="Right"/>
                </Border>
                <TextBox x:Name="NewAlias"
                         MaxLength="64"/>
            </DockPanel>

            <!-- Hostname TextBox-->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Border Width="50" Margin="0,0,15,0">
                    <TextBlock Text="{x:Static resource:Strings.NewAlias_Host}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="#404040"
                               HorizontalAlignment="Right"/>
                </Border>
                <TextBox x:Name="Hostname"
                         MaxLength="64"/>
            </DockPanel>
        </DockPanel>

        <!-- Buttons -->
        <Grid Grid.Row="1" Margin="9,0,9,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Only shown when editing an existing alias -->
            <Button x:Name="RemoveButton"
                    Style="{StaticResource ButtonStyle}"
                    Width="85"
                    Visibility="Collapsed"
                    Click="Remove_Click"
                    Content="_Remove" />
            <Button Grid.Column="2"
                    Style="{StaticResource ButtonStyle}"
                    IsDefault="True"
                    Margin="0,0,9,0"
                    Click="Save_Click"
                    Width="85"
                    Content="_Save" />
            <Button Grid.Column="3"
                    Style="{StaticResource ButtonStyle}"
                    Width="85"
                    IsCancel="True"
                    Content="{x:Static resource:Strings.DialogButton_Cancel}" />
        </Grid>
    </Grid>
</Window>
