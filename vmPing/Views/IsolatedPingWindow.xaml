<Window x:Class="vmPing.Views.IsolatedPingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:vmPing.Controls"
        UseLayoutRounding="True"
        Height="500"
        Width="450"
        MinHeight="200"
        MinWidth="300"
        Background="{DynamicResource Theme.Window.Background}"
        Closed="Window_Closed">
    <!-- The window title is the alias, else the hostname, else vmPing. Later triggers win. -->
    <Window.Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="Title" Value="{Binding DisplayAlias}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayAlias}" Value="{x:Null}">
                    <Setter Property="Title" Value="{Binding Hostname}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayAlias}" Value="">
                    <Setter Property="Title" Value="{Binding Hostname}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Hostname}" Value="{x:Null}">
                    <Setter Property="Title" Value="vmPing"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Hostname}" Value="">
                    <Setter Property="Title" Value="vmPing"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <!-- Items Control -->
    <Border BorderBrush="{DynamicResource Theme.Probe.Divider}" BorderThickness="0,1,0,0" Margin="0,0,0,0" CornerRadius="0"
            Background="{Binding Status, Converter={StaticResource ProbeStatusToBackgroundBrushConverter}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ping output section -->
            <DockPanel Grid.Row="1">
                
                <!-- Ping statistics -->
                <DockPanel DockPanel.Dock="Bottom"
                           Background="{DynamicResource Theme.Probe.StatusBar.Background}">
                    <DockPanel.Style>
                        <Style TargetType="{x:Type DockPanel}">
                            <!-- Statistics are show only if: ProbeType = Ping and Statistics.Sent != 0 -->
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Ping">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Statistics.Sent}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <DockPanel.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource ProbeStatusToStatisticsBrushConverter}}"/>
                            <!-- Numbers flash when they change -->
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             AutoReverse="True"
                                                             From="1.0" To="0.75" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Resources>
                    <!-- Full line when it fits, else just the sent and received counts -->
                    <c:FirstFitPanel Margin="6,2,6,3">
                        <!-- Full: the gaps between the counts shrink from 16 to 6 before switching -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100*" MinWidth="6" MaxWidth="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100*" MinWidth="6" MaxWidth="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Sent: " Opacity="0.8"/>
                                <TextBlock Text="{Binding Statistics.Sent, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="Received: " Opacity="0.8"/>
                                <TextBlock Text="{Binding Statistics.Received, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <TextBlock Text="Lost: " Opacity="0.8"/>
                                <TextBlock Text="{Binding Statistics.Lost, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"/>
                            </StackPanel>
                        </Grid>
                        <!-- Compact: arrows for sent and received, no lost count -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2191;" Opacity="0.8" Margin="0,0,2,0"/>
                            <TextBlock Text="{Binding Statistics.Sent, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"/>
                            <TextBlock Text="&#x2193;" Opacity="0.8" Margin="8,0,2,0"/>
                            <TextBlock Text="{Binding Statistics.Received, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"/>
                        </StackPanel>
                    </c:FirstFitPanel>
                </DockPanel>

                <!-- Ping history -->
                <c:ProbeOutputBox x:Name="History"
                                  Probe="{Binding}"
                                  Foreground="{Binding Status, Converter={StaticResource ProbeStatusToForegroundBrushConverter}}"
                                  FontSize="{Binding Type, Converter={StaticResource ProbeTypeToFontSizeConverter}}">
                    <c:ProbeOutputBox.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ScrollBarStyle.Probe}">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </c:ProbeOutputBox.Resources>
                </c:ProbeOutputBox>
            </DockPanel>

            
            <!-- Hostname section -->
            <Border Grid.Row="0"
                    MinHeight="30"
                    Background="#80000000">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Label Style="{StaticResource ProbeTypeLabel}"
                           Margin="0,0,8,0"/>
                    <!-- The alias, or the hostname if there's no alias -->
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#eee"
                               FontSize="20"
                               Padding="0,0,0,5"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Text" Value="{Binding DisplayAlias}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DisplayAlias}" Value="{x:Null}">
                                        <Setter Property="Text" Value="{Binding Hostname}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayAlias}" Value="">
                                        <Setter Property="Text" Value="{Binding Hostname}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
