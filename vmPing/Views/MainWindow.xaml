<Window x:Class="vmPing.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:probes="clr-namespace:vmPing.Probes"
        xmlns:c="clr-namespace:vmPing.Controls"
        xmlns:resource="clr-namespace:vmPing.Properties"
        Title="vmPing"
        UseLayoutRounding="False"
        SnapsToDevicePixels="True"
        Height="400"
        Width="800"
        MinHeight="200"
        MinWidth="350"
        Background="{DynamicResource Theme.Window.Background}"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        ContentRendered="Window_ContentRendered"
        IsVisibleChanged="Window_IsVisibleChanged">

    <Window.Resources>
        <!-- Override default context menu animation: set to no animation -->
        <PopupAnimation x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>

        <!-- Probe spacing. RefreshProbeSpacing sets these from the "Space between probes" option. -->
        <Thickness x:Key="Probes.Padding">2</Thickness>
        <Thickness x:Key="Probes.Margin">0</Thickness>
        <SolidColorBrush x:Key="Probes.BorderBrush" Color="Transparent"/>
        <Thickness x:Key="Probe.Margin">2</Thickness>
        <Thickness x:Key="Probe.BorderThickness">1</Thickness>
        <SolidColorBrush x:Key="Probe.BorderBrush" Color="Transparent"/>
        <CornerRadius x:Key="Probe.CornerRadius">4</CornerRadius>
        <CornerRadius x:Key="Probe.TopCornerRadius">3,3,0,0</CornerRadius>
        <CornerRadius x:Key="Probe.BottomCornerRadius">0,0,3,3</CornerRadius>

        <!-- Probe title bar buttons. The button's content is the icon. -->
        <Style x:Key="ProbeTitleButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="1500"/>
            <Setter Property="ToolTipService.ShowDuration" Value="2000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <!-- Hover highlight -->
                            <Border x:Name="highlight"
                                    Background="{DynamicResource Theme.Probe.TitleBar.Icon}"
                                    CornerRadius="3"
                                    Opacity="0"/>
                            <!-- Icon -->
                            <Image x:Name="icon"
                                   Source="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Width="14"
                                   Height="14"
                                   Margin="{TemplateBinding Padding}"
                                   Opacity="0.9"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="highlight" Property="Opacity" Value="0.22"/>
                                <Setter TargetName="icon" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="highlight" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="icon" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template for hostname textbox -->
        <ControlTemplate x:Key="TextBoxControlTemplate" TargetType="{x:Type TextBox}">
            <Grid>
                <Border x:Name="border"
                        CornerRadius="0"
                        SnapsToDevicePixels="True"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}">
                    <ScrollViewer x:Name="PART_ContentHost"/>
                </Border>
                <!-- Alias, shown instead of the hostname when the box isn't being edited -->
                <TextBlock x:Name="aliasText"
                           Text="{Binding DisplayAlias}"
                           Visibility="Collapsed"
                           Margin="2,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>
                <TextBlock x:Name="placeholderText"
                           Text="{x:Static resource:Strings.ProbeType_PingHint}"
                           Visibility="Hidden"
                           FontSize="12"
                           Opacity="0.3"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Padding="5,0,0,0"
                           IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Text" Value=""/>
                        <Condition Property="IsKeyboardFocused" Value="True"/>
                    </MultiTrigger.Conditions>
                    <MultiTrigger.Setters>
                        <Setter Property="Visibility" TargetName="placeholderText" Value="Visible"/>
                    </MultiTrigger.Setters>
                </MultiTrigger>
                <!-- Show the alias unless the box is focused for editing. No alias: show the hostname. -->
                <Trigger Property="IsKeyboardFocused" Value="False">
                    <Setter Property="Visibility" TargetName="aliasText" Value="Visible"/>
                    <Setter Property="Visibility" TargetName="PART_ContentHost" Value="Hidden"/>
                </Trigger>
                <DataTrigger Binding="{Binding DisplayAlias}" Value="{x:Null}">
                    <Setter Property="Visibility" TargetName="aliasText" Value="Collapsed"/>
                    <Setter Property="Visibility" TargetName="PART_ContentHost" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayAlias}" Value="">
                    <Setter Property="Visibility" TargetName="aliasText" Value="Collapsed"/>
                    <Setter Property="Visibility" TargetName="PART_ContentHost" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Dns">
                    <Setter Property="Text" TargetName="placeholderText" Value="{x:Static resource:Strings.ProbeType_DnsHint}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Traceroute">
                    <Setter Property="Text" TargetName="placeholderText" Value="{x:Static resource:Strings.ProbeType_TracerouteHint}"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <!-- Root DockPanel -->
    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top"
              FontStretch="Normal">
            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MenuItemStyle}"/>
            </Menu.Resources>
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch" LastChildFill="False" Background="{DynamicResource Theme.Panel.Background}"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            
            <!-- Menu: Add Probe -->
            <MenuItem x:Name="AddProbeMenu">
                <MenuItem.Header>
                    <AccessText Text="{x:Static resource:Strings.Toolbar_Add}" VerticalAlignment="Center"/>
                </MenuItem.Header>
                <MenuItem.Icon>
                    <Image Source="{DynamicResource icon.add}" VerticalAlignment="Center" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>

            <!-- Menu: Columns -->
            <MenuItem>
                <MenuItem.Header>
                    <AccessText Text="{x:Static resource:Strings.Toolbar_Columns}" VerticalAlignment="Center"/>
                </MenuItem.Header>
                <MenuItem.Icon>
                    <Image Source="{DynamicResource icon.columns-grid}" VerticalAlignment="Center" Width="16" Height="16"/>
                </MenuItem.Icon>
                <!-- Columns slider -->
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding ElementName=ColumnCount, Path=Value}"
                           Foreground="{DynamicResource Theme.Text}"
                           Margin="0,0,15,0"
                           Width="30"
                           FontSize="14"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center"/>
                    <Slider Name="ColumnCount"
                            Style="{DynamicResource SliderStyle}"
                            ValueChanged="ColumnCount_ValueChanged"
                            Minimum="1"
                            Maximum="10"
                            Value="3"
                            TickFrequency="1"
                            SmallChange="1"
                            TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"
                            Width="200"
                            Foreground="{DynamicResource Theme.Text.Secondary}"
                            Margin="0,8"/>
                </StackPanel>
            </MenuItem>

            <!-- Menu: Start/Stop All -->
            <MenuItem x:Name="StartStopMenu">
                <MenuItem.Header>
                    <AccessText Name="StartStopMenuHeader"
                                VerticalAlignment="Center"
                                Text="{Binding Path=(probes:Probe.ActiveCount), Converter={StaticResource ProbeCountToGlobalStartStopText}}"/>
                </MenuItem.Header>
                <MenuItem.Icon>
                    <Image Name="StartStopMenuImage"
                           VerticalAlignment="Center"
                           Width="16" Height="16">
                        <Image.Style>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Source" Value="{DynamicResource icon.stop-circle}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=(probes:Probe.ActiveCount)}" Value="0">
                                        <Setter Property="Source" Value="{DynamicResource icon.play}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </MenuItem.Icon>
            </MenuItem>

            <!-- Menu: Main menu dropdown -->
            <MenuItem Width="40"
                      DockPanel.Dock="Right"
                      Template="{StaticResource TopLevelHeaderNoPaddingTemplate}">
                <MenuItem.Icon>
                    <Image Source="{DynamicResource icon.chevron-circle-down}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16"/>
                </MenuItem.Icon>

                <!-- Menu: Options -->
                <MenuItem Name="OptionsMenu"
                          Header="{x:Static resource:Strings.Menu_Options}"
                          InputGestureText="F10">
                    <MenuItem.Icon>
                        <Image Source="{DynamicResource icon.options}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- Menu: Multi-Input -->
                <MenuItem Name="MultiInputMenu" Header="Multi-input" InputGestureText="F2">
                    <MenuItem.Icon>
                        <Image Source="{DynamicResource icon.input-addresses}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Menu: History -->
                <MenuItem Name="StatusHistoryMenu" Header="{x:Static resource:Strings.Menu_StatusHistory}" InputGestureText="F12">
                    <MenuItem.Icon>
                        <Image Source="{DynamicResource icon.status-history}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- Menu: Favorites -->
                <MenuItem Header="{x:Static resource:Strings.Menu_FavoriteSets}" x:Name="FavoritesMenu">
                    <MenuItem Header="{x:Static resource:Strings.Menu_SaveToFavorites}" Click="CreateFavorite_Click">
                        <MenuItem.Icon>
                            <Image Source="{DynamicResource icon.new-favorite}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{x:Static resource:Strings.Menu_ManageFavorites}" Click="ManageFavorites_Click">
                        <MenuItem.Icon>
                            <Image Source="{DynamicResource icon.favorite}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                </MenuItem>
                <!-- Menu: Aliases-->
                <MenuItem Header="{x:Static resource:Strings.Menu_Aliases}" x:Name="AliasesMenu">
                    <MenuItem Header="{x:Static resource:Strings.Menu_ManageAliases}" Click="ManageAliases_Click">
                        <MenuItem.Icon>
                            <Image Source="{DynamicResource icon.alias}" VerticalAlignment="Center" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                </MenuItem>
                <Separator/>
                <!-- Menu: Popup alerts -->
                <MenuItem Header="{x:Static resource:Strings.Menu_PopupAlerts}">
                    <MenuItem Name="PopupNever"
                              Header="{x:Static resource:Strings.Notification_Never}"
                              Click="PopupNever_Click"
                              IsCheckable="True"/>
                    <MenuItem Name="PopupWhenMinimized"
                              Header="{x:Static resource:Strings.Notification_WhenMinimized}"
                              Click="PopupWhenMinimized_Click"
                              IsCheckable="True"/>
                    <MenuItem Name="PopupAlways"
                              Header="{x:Static resource:Strings.Notification_Always}"
                              Click="PopupAlways_Click"
                              IsCheckable="True"/>
                </MenuItem>
                <Separator/>
                <!-- Menu: Traceroute -->
                <MenuItem Header="{x:Static resource:Strings.Menu_Traceroute}" x:Name="TracerouteMenu" InputGestureText="Ctrl-T">
                    <MenuItem.Icon>
                        <Image Source="{DynamicResource icon.route}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Menu: Flood host -->
                <MenuItem Header="{x:Static resource:Strings.Menu_FloodHost}" x:Name="FloodHostMenu" InputGestureText="Ctrl-F">
                    <MenuItem.Icon>
                        <Image Source="{DynamicResource icon.flood-host}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Menu: New instance -->
                <MenuItem Header="vmPing" x:Name="NewInstanceMenu" InputGestureText="Ctrl-N">
                    <MenuItem.Icon>
                        <Image Source="{DynamicResource icon.vmping-logo-simple}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- Menu: Help -->
                <MenuItem Header="{x:Static resource:Strings.Menu_Help}" x:Name="HelpMenu" InputGestureText="F1">
                    <MenuItem.Icon>
                        <Image Source="{DynamicResource icon.question-circle}" VerticalAlignment="Center" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>


        <!-- Probe type menu. Opens when / is typed in an empty hostname box, or the probe type label is clicked. -->
        <Popup x:Name="ProbeTypeMenu"
               DockPanel.Dock="Top"
               Placement="Custom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource Theme.Popup.Background}"
                    BorderBrush="{DynamicResource Theme.Popup.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4"
                    Margin="0,2,0,0">
                <ListBox x:Name="ProbeTypeList"
                         Focusable="False"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource ProbeTypeMenuItem}"
                         PreviewMouseLeftButtonUp="ProbeTypeList_PreviewMouseLeftButtonUp">
                    <ListBoxItem Tag="{x:Static probes:ProbeType.Ping}"
                                 TextSearch.Text="{x:Static resource:Strings.ProbeType_PingKey}"
                                 Content="{x:Static resource:Strings.ProbeType_Ping}"/>
                    <ListBoxItem Tag="{x:Static probes:ProbeType.Dns}"
                                 TextSearch.Text="{x:Static resource:Strings.ProbeType_DnsKey}"
                                 Content="{x:Static resource:Strings.ProbeType_Dns}"/>
                    <ListBoxItem Tag="{x:Static probes:ProbeType.Traceroute}"
                                 TextSearch.Text="{x:Static resource:Strings.ProbeType_TracerouteKey}"
                                 Content="{x:Static resource:Strings.ProbeType_Traceroute}"/>
                </ListBox>
            </Border>
        </Popup>

        <!-- Items Control -->
        <ItemsControl Name="ProbeItemsControl" UseLayoutRounding="True" IsTabStop="False" Focusable="False" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Probes.BorderBrush}" Padding="{DynamicResource Probes.Padding}" Margin="{DynamicResource Probes.Margin}"
                      Background="Transparent" AllowDrop="True" DragOver="Probe_DragOver" Drop="Probe_Drop">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="{DynamicResource Probe.Margin}"
                            BorderThickness="{DynamicResource Probe.BorderThickness}"
                            BorderBrush="{DynamicResource Probe.BorderBrush}"
                            CornerRadius="{DynamicResource Probe.CornerRadius}">
                        <!-- Probe status color -->
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{Binding Status, Converter={StaticResource ProbeStatusToBackgroundBrushConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsComment}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Theme.Probe.Comment.Background}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Name="ProbeGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Ping output section -->
                            <DockPanel AllowDrop="True"
                                       DragEnter="Probe_DragEnter"
                                       DragOver="Probe_DragOver"
                                       Drop="Probe_Drop">

                                <!-- Ping title bar / button section -->
                                <Grid DockPanel.Dock="Top" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Hover band -->
                                    <Border Grid.ColumnSpan="3"
                                            Background="{DynamicResource Theme.Probe.TitleBar.Background}"
                                            CornerRadius="{DynamicResource Probe.TopCornerRadius}"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=ProbeGrid, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Grip icon. Clicks go through to the drag area. -->
                                    <Border Grid.Column="0"
                                            Padding="6,0,0,0"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=ProbeGrid, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Path Data="M0,0 h2 v2 h-2 z M4,0 h2 v2 h-2 z M0,4 h2 v2 h-2 z M4,4 h2 v2 h-2 z M0,8 h2 v2 h-2 z M4,8 h2 v2 h-2 z"
                                              Fill="{DynamicResource Theme.Probe.TitleBar.Icon}"
                                              Opacity="0.7"
                                              VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Drag area: the grip and the empty part of the title bar. Drag it to move the probe. -->
                                    <Border Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Background="Transparent"
                                            PreviewMouseLeftButtonDown="ProbeTitle_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="ProbeTitle_PreviewMouseMove"/>

                                    <!-- Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=ProbeGrid, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Button: Edit alias -->
                                        <Button Style="{StaticResource ProbeTitleButtonStyle}"
                                                Content="{DynamicResource icon.pencil}"
                                                Margin="0,0,1,0"
                                                ToolTip="{x:Static resource:Strings.Tooltip_EditAlias}"
                                                IsEnabled="{Binding ElementName=Hostname, Path=Text, Converter={StaticResource StringLengthToBoolConverter}}"
                                                Click="EditAlias_Click"/>

                                        <!-- Button: Isolated view -->
                                        <Button Style="{StaticResource ProbeTitleButtonStyle}"
                                                Content="{DynamicResource icon.window-restore}"
                                                Margin="0,0,1,0"
                                                ToolTip="{x:Static resource:Strings.Tooltip_IsolatedView}"
                                                Click="IsolatedView_Click"/>

                                        <!-- Button: Remove probe -->
                                        <Button Style="{StaticResource ProbeTitleButtonStyle}"
                                                Content="{DynamicResource icon.window-close}"
                                                ToolTip="{x:Static resource:Strings.Tooltip_Close}"
                                                Click="RemoveProbe_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Ping statistics -->
                                <DockPanel DockPanel.Dock="Bottom"
                                           Background="{DynamicResource Theme.Probe.StatusBar.Background}">
                                    <DockPanel.Style>
                                        <Style TargetType="{x:Type DockPanel}">
                                            <!-- Statistics are show only if: ProbeType = Ping and Statistics.Sent != 0 -->
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=Type}" Value="Ping">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=Statistics.Sent}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <DockPanel.Resources>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource ProbeStatusToStatisticsBrushConverter}}"/>
                                            <!-- Numbers flash when they change -->
                                            <Style.Triggers>
                                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             AutoReverse="True"
                                                                             From="1.0" To="0.75" Duration="0:0:0.3"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Resources>
                                    <!-- Full line when it fits, else just the sent and received counts -->
                                    <c:FirstFitPanel Margin="6,2,6,3">
                                        <!-- Full: the gaps between the counts shrink from 16 to 6 before switching -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100*" MinWidth="6" MaxWidth="16"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100*" MinWidth="6" MaxWidth="16"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="Sent: " Opacity="0.8"/>
                                                <TextBlock Text="{Binding Statistics.Sent, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="Received: " Opacity="0.8"/>
                                                <TextBlock Text="{Binding Statistics.Received, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                <TextBlock Text="Lost: " Opacity="0.8"/>
                                                <TextBlock Text="{Binding Statistics.Lost, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"/>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Compact: arrows for sent and received, no lost count -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2191;" Opacity="0.8" Margin="0,0,2,0"/>
                                            <TextBlock Text="{Binding Statistics.Sent, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"/>
                                            <TextBlock Text="&#x2193;" Opacity="0.8" Margin="8,0,2,0"/>
                                            <TextBlock Text="{Binding Statistics.Received, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}"/>
                                        </StackPanel>
                                    </c:FirstFitPanel>
                                </DockPanel>

                                <!-- Output, or a comment in its place -->
                                <Grid>
                                    <!-- Ping history -->
                                    <c:ProbeOutputBox x:Name="History"
                                                      Probe="{Binding}"
                                                      Foreground="{Binding Status, Converter={StaticResource ProbeStatusToForegroundBrushConverter}}"
                                                      FontSize="{Binding Type, Converter={StaticResource ProbeTypeToFontSizeConverter}}">
                                        <c:ProbeOutputBox.Resources>
                                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ScrollBarStyle.Probe}">
                                                <Setter Property="Opacity" Value="0.6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=ProbeGrid, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </c:ProbeOutputBox.Resources>
                                    </c:ProbeOutputBox>

                                    <!-- Comment, shown in place of the output. Click to edit it. -->
                                    <Border Background="Transparent"
                                            MouseLeftButtonUp="Comment_MouseLeftButtonUp">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsComment}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding CommentText}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Theme.Probe.Comment.Foreground}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="8"/>
                                    </Border>
                                </Grid>
                            </DockPanel>

                            <!-- Hostname and ping button section -->
                            <Grid Grid.Row="1">
                                <!-- Hidden for comments, except while editing. Opacity keeps it clickable and focusable. -->
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsComment}" Value="True"/>
                                                    <Condition Binding="{Binding ElementName=Hostname, Path=IsKeyboardFocused}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity" Value="0"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Border to set background color and top border for this section.
                                     Gray while the probe runs, since the hostname can't be edited then. -->
                                <Border Grid.ColumnSpan="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Theme.Panel.Border}" CornerRadius="{DynamicResource Probe.BottomCornerRadius}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Control.Background}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Theme.Panel.Background}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Status glyph -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Status, Converter={StaticResource ProbeStatusToGlyphConverter}}"
                                           FontSize="14"
                                           FontFamily="Marlett"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.Text}"
                                           Padding="4,0,1,0">
                                </TextBlock>

                                <!-- Probe type label. Click to change the probe type. -->
                                <Label Grid.Column="1"
                                       Style="{StaticResource ProbeTypeLabel}"
                                       Margin="2,0,4,0"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="ProbeTypeLabel_MouseLeftButtonUp"/>

                                <!-- Hostname textbox -->
                                <TextBox Name="Hostname"
                                         Grid.Column="2"
                                         FontWeight="SemiBold"
                                         FontSize="{Binding ElementName=History, Path=ActualWidth, Converter={StaticResource HostnameFontsizeConverter}}"
                                         BorderThickness="0,0,0,0"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         Padding="0,0,0,0"
                                         Text="{Binding HostLine, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsActive, Converter={StaticResource InverseBooleanConverter}}"
                                         Template="{StaticResource TextBoxControlTemplate}"
                                         Loaded="Hostname_Loaded"
                                         PreviewTextInput="Hostname_PreviewTextInput"
                                         PreviewKeyDown="Hostname_PreviewKeyDown"
                                         KeyDown="Hostname_KeyDown"
                                         LostKeyboardFocus="Hostname_LostKeyboardFocus">
                                    <!-- A comment's hostname box only takes focus when the comment is clicked.
                                         Otherwise focus could land there when other probes start. -->
                                    <TextBox.Style>
                                        <Style TargetType="{x:Type TextBox}">
                                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                                            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}"/>
                                            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Accent}"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsComment}" Value="True"/>
                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsKeyboardFocused}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Focusable" Value="False"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Ping button -->
                                <Button Click="ProbeStartStop_Click"
                                        Grid.Column="3"
                                        FontSize="14"
                                        Padding="0,2"
                                        Margin="2"
                                        HorizontalAlignment="Right"
                                        Background="{DynamicResource Theme.Control.Background}">
                                    <!-- Comments can't be started, so the button can't be focused or clicked. -->
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsComment}" Value="True">
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="PingButtonBorder" BorderThickness="1" BorderBrush="{DynamicResource Theme.Control.Border}"
                                                    CornerRadius="4"
                                                    Background="{TemplateBinding Background}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                                                    <Image Width="16" Height="16"
                                                           Margin="0,6">
                                                        <Image.Style>
                                                            <Style TargetType="{x:Type Image}">
                                                                <Setter Property="Source" Value="{DynamicResource icon.stop-circle}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Source" Value="{DynamicResource icon.play}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <TextBlock Visibility="{Binding ElementName=History, Path=ActualWidth, Converter={StaticResource ButtonTextVisibilityConverter}}"
                                                               Foreground="{DynamicResource Theme.Text}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0">
                                                        <!-- Ping or Stop, or a label for the probe type when it isn't a ping probe -->
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Text" Value="{Binding IsActive, Converter={StaticResource BoolToStringConverter}}"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="Dns"/>
                                                                            <Condition Binding="{Binding IsActive}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Text" Value="{x:Static resource:Strings.Button_LookUp}"/>
                                                                    </MultiDataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="Traceroute"/>
                                                                            <Condition Binding="{Binding IsActive}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Text" Value="{x:Static resource:Strings.Button_Trace}"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PingButtonBorder" Property="Background" Value="{DynamicResource Theme.Control.Hover.Background}"/>
                                                    <Setter TargetName="PingButtonBorder" Property="BorderBrush" Value="{DynamicResource Theme.Control.Hover.Border}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="PingButtonBorder" Property="Background" Value="{DynamicResource Theme.Control.Pressed.Background}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- ColumnCount.Tag is updated to contain the lesser of the two values: ColumnCount.Value and the number of probes -->
                    <c:ProbeGrid Columns="{Binding ElementName=ColumnCount, Path=Tag}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DockPanel>
</Window>
