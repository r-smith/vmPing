<Window x:Class="vmPing.Views.ManageFavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resource="clr-namespace:vmPing.Properties"
        Title="{x:Static resource:Strings.ManageFavorites_WindowTitle}"
        UseLayoutRounding="True"
        Height="500"
        MinHeight="380"
        Width="760"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#f0f0f0"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">

    <Grid Margin="9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource icon.favorite}" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource ResourceKey=OptionHeaderTextStyle}"
                       Text="{x:Static resource:Strings.ManageFavorites_Header}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Favorites list -->
            <DockPanel>
                <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,9,0,0">
                    <Button x:Name="NewButton"
                            Margin="0,0,3,0"
                            Style="{StaticResource ButtonStandardStyle}"
                            Content="New"
                            Click="New_Click"/>
                    <Button x:Name="DuplicateButton"
                            Margin="3,0"
                            Style="{StaticResource ButtonStandardStyle}"
                            Content="Duplicate"
                            Click="Duplicate_Click"/>
                    <Button x:Name="DeleteButton"
                            Margin="3,0,0,0"
                            Style="{StaticResource ButtonStandardStyle}"
                            Content="Delete"
                            Click="Delete_Click"/>
                </UniformGrid>

                <Grid>
                    <ListBox x:Name="Favorites"
                             Style="{StaticResource FavoritesListBox}"
                             ItemContainerStyle="{StaticResource FavoritesListBoxItemsStyle}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             TextSearch.TextPath="Title"
                             SelectionChanged="Favorites_SelectionChanged"
                             MouseDoubleClick="Favorites_MouseDoubleClick"
                             KeyDown="Favorites_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"
                                           Margin="2,3"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Shown when there are no favorites -->
                    <TextBlock x:Name="EmptyListText"
                               Text="No favorites yet."
                               Foreground="#707070"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>

            <!-- Editor -->
            <Border Grid.Column="2"
                    Background="#fcfcfc"
                    BorderBrush="#abadb3"
                    BorderThickness="1">
                <Grid>
                    <DockPanel x:Name="Editor" Margin="10">
                        <!-- Name and columns -->
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Name"
                                           Foreground="#404040"
                                           FontSize="14"/>
                                <TextBox x:Name="FavoriteName"
                                         Margin="0,4,0,0"
                                         MaxLength="64"
                                         TextChanged="Editor_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Width="80" Margin="20,0,0,0">
                                <TextBlock Text="Columns"
                                           Foreground="#404040"
                                           FontSize="14"/>
                                <TextBox x:Name="FavoriteColumns"
                                         Margin="0,4,0,0"
                                         MaxLength="2"
                                         PreviewTextInput="FavoriteColumns_PreviewTextInput"
                                         TextChanged="Editor_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Save and revert -->
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
                            <Button x:Name="SaveButton"
                                    DockPanel.Dock="Right"
                                    Width="85"
                                    Margin="9,0,0,0"
                                    Style="{StaticResource ButtonStandardStyle}"
                                    Content="{x:Static resource:Strings.DialogButton_Save}"
                                    Click="Save_Click"/>
                            <Button x:Name="RevertButton"
                                    DockPanel.Dock="Right"
                                    Width="85"
                                    Style="{StaticResource ButtonStandardStyle}"
                                    Content="Revert"
                                    Click="Revert_Click"/>
                            <TextBlock x:Name="UnsavedText"
                                       DockPanel.Dock="Right"
                                       Text="Unsaved changes"
                                       Foreground="#707070"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"/>
                        </DockPanel>

                        <!-- Hosts -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="Hosts"
                                       Foreground="#404040"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Label Style="{StaticResource LabelToolTip}" MaxWidth="380">
                                <TextBlock>
                                    Enter one host per line, or separate them with commas.<LineBreak/>
                                    Add a label after a host with #, or start a line with # for a comment.<LineBreak/><LineBreak/>
                                    If you have a text file containing hosts, drag and drop it here.
                                </TextBlock>
                            </Label>
                        </StackPanel>
                        <TextBox x:Name="FavoriteHosts"
                                 Margin="0,4,0,0"
                                 Padding="4"
                                 FontFamily="Consolas"
                                 FontSize="15"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 AllowDrop="True"
                                 PreviewDragOver="FavoriteHosts_PreviewDragOver"
                                 Drop="FavoriteHosts_Drop"
                                 TextChanged="Editor_TextChanged"/>
                    </DockPanel>

                    <!-- Shown when no favorite is selected -->
                    <TextBlock x:Name="NoSelectionText"
                               Text="Select a favorite to edit it, or click New to create one."
                               Foreground="#707070"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="20"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Open and close -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
            <Button x:Name="OpenButton"
                    Width="85"
                    Style="{StaticResource ButtonStandardStyle}"
                    Content="Open"
                    Click="Open_Click"/>
            <Button Width="85"
                    Margin="9,0,0,0"
                    Style="{StaticResource ButtonStandardStyle}"
                    Content="Close"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
