<Window x:Class="vmPing.Views.ManageFavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resource="clr-namespace:vmPing.Properties"
        Title="{x:Static resource:Strings.ManageFavorites_WindowTitle}"
        UseLayoutRounding="True"
        Height="500"
        MinHeight="380"
        Width="740"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.Window.Background}"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">

    <Grid Margin="9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource icon.favorite}" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource ResourceKey=OptionHeaderTextStyle}"
                       Text="{x:Static resource:Strings.ManageFavorites_Header}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Favorites list -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <ListBox x:Name="Favorites"
                             Style="{StaticResource FavoritesListBox}"
                             ItemContainerStyle="{StaticResource FavoritesListBoxItemsStyle}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             TextSearch.TextPath="Title"
                             AllowDrop="True"
                             SelectionChanged="Favorites_SelectionChanged"
                             MouseDoubleClick="Favorites_MouseDoubleClick"
                             KeyDown="Favorites_KeyDown"
                             PreviewMouseLeftButtonDown="Favorites_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="Favorites_PreviewMouseMove"
                             DragOver="Favorites_DragOver"
                             DragLeave="Favorites_DragLeave"
                             Drop="Favorites_Drop"
                             GiveFeedback="Favorites_GiveFeedback">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="FavoriteTitle"
                                           Text="{Binding Title}"
                                           Margin="16,3,2,3"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Favorites without a group aren't indented. -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Group}" Value="">
                                        <Setter TargetName="FavoriteTitle" Property="Margin" Value="2,3"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <!-- The transparent background lets the whole header width be right-clicked. -->
                                        <Border x:Name="GroupHeader" Background="Transparent">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Rename group..." Click="RenameGroup_Click"/>
                                                    <MenuItem Header="Remove group" Click="RemoveGroup_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource Theme.Text.Secondary}"
                                                       FontWeight="SemiBold"
                                                       Margin="6,6,2,2"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <!-- Favorites without a group have no header. -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="">
                                                <Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <!-- The default group template indents items by 5 pixels, which left a gap beside selected items. -->
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <!-- The background highlights the group while a favorite is dragged over it. -->
                                                    <StackPanel Background="{TemplateBinding Background}">
                                                        <ContentPresenter/>
                                                        <ItemsPresenter/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <!-- Shown when there are no favorites -->
                    <TextBlock x:Name="EmptyListText"
                               Text="No favorites yet."
                               Foreground="{DynamicResource Theme.Text.Secondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="3" Margin="0,9,0,0">
                    <Button x:Name="NewButton"
                            Margin="0,0,3,0"
                            Style="{StaticResource ButtonStyle}"
                            Content="_New"
                            Click="New_Click"/>
                    <Button x:Name="DuplicateButton"
                            Margin="3,0"
                            Style="{StaticResource ButtonStyle}"
                            Content="D_uplicate"
                            Click="Duplicate_Click"/>
                    <Button x:Name="DeleteButton"
                            Margin="3,0,0,0"
                            Style="{StaticResource ButtonStyle}"
                            Content="_Delete"
                            Click="Delete_Click"/>
                </UniformGrid>
            </Grid>

            <!-- Editor -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Theme.Panel.Background}"
                    BorderBrush="{DynamicResource Theme.Panel.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid x:Name="Editor" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Name, columns, and group -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Name"
                                           Foreground="{DynamicResource Theme.Text}"
                                           FontSize="14"/>
                                <TextBox x:Name="FavoriteName"
                                         Margin="0,4,0,0"
                                         MaxLength="64"
                                         TextChanged="Editor_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Width="80" Margin="20,0,0,0">
                                <TextBlock Text="Columns"
                                           Foreground="{DynamicResource Theme.Text}"
                                           FontSize="14"/>
                                <TextBox x:Name="FavoriteColumns"
                                         Margin="0,4,0,0"
                                         MaxLength="2"
                                         PreviewTextInput="FavoriteColumns_PreviewTextInput"
                                         TextChanged="Editor_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <TextBlock Text="Group"
                                           Foreground="{DynamicResource Theme.Text}"
                                           FontSize="14"/>
                                <!-- Pick an existing group, or type a new one. Leave it empty for no group. -->
                                <ComboBox x:Name="FavoriteGroup"
                                          Margin="0,4,0,0"
                                          HorizontalAlignment="Stretch"
                                          IsEditable="True"
                                          TextBoxBase.TextChanged="Editor_TextChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Hosts -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="Hosts"
                                       Foreground="{DynamicResource Theme.Text}"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Label Style="{StaticResource LabelToolTip}" MaxWidth="380">
                                <TextBlock>
                                    Enter one host per line, or separate them with commas.<LineBreak/>
                                    Add a label after a host with #, or start a line with # for a comment.<LineBreak/><LineBreak/>
                                    If you have a text file containing hosts, drag and drop it here.
                                </TextBlock>
                            </Label>
                        </StackPanel>
                        <TextBox x:Name="FavoriteHosts"
                                 Grid.Row="2"
                                 Margin="0,4,0,0"
                                 Padding="4"
                                 FontFamily="Consolas"
                                 FontSize="15"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 AllowDrop="True"
                                 PreviewDragOver="FavoriteHosts_PreviewDragOver"
                                 Drop="FavoriteHosts_Drop"
                                 TextChanged="Editor_TextChanged"/>

                        <!-- Save and revert -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <TextBlock x:Name="UnsavedText"
                                       Text="Unsaved changes"
                                       Foreground="{DynamicResource Theme.Text.Secondary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"/>
                            <Button x:Name="RevertButton"
                                    Width="85"
                                    Style="{StaticResource ButtonStyle}"
                                    Content="_Revert"
                                    Click="Revert_Click"/>
                            <Button x:Name="SaveButton"
                                    Width="85"
                                    Margin="9,0,0,0"
                                    Style="{StaticResource ButtonStyle}"
                                    Content="_Save"
                                    Click="Save_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Shown when no favorite is selected -->
                    <TextBlock x:Name="NoSelectionText"
                               Text="Select a favorite to edit it, or click New to create one."
                               Foreground="{DynamicResource Theme.Text.Secondary}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="20"/>
                </Grid>
            </Border>
        </Grid>

        <!-- The favorite's name, shown beside the mouse pointer while dragging -->
        <Popup x:Name="DragLabelPopup"
               Placement="Absolute"
               AllowsTransparency="True"
               IsHitTestVisible="False">
            <Border Background="{DynamicResource Theme.Item.Selected.Background}"
                    BorderBrush="{DynamicResource Theme.Item.Selected.Border}"
                    BorderThickness="1"
                    Padding="6,2"
                    Opacity="0.85">
                <TextBlock x:Name="DragLabel"
                           FontSize="14"
                           Foreground="{DynamicResource Theme.Text}"/>
            </Border>
        </Popup>

        <!-- Open and close -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
            <Button x:Name="OpenButton"
                    Width="85"
                    Style="{StaticResource ButtonStyle}"
                    Content="_Open"
                    Click="Open_Click"/>
            <Button Width="85"
                    Margin="9,0,0,0"
                    Style="{StaticResource ButtonStyle}"
                    Content="_Close"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
