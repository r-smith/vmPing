<Window x:Class="vmPing.Views.ManageThemesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage themes"
        UseLayoutRounding="True"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.Window.Background}"
        ShowInTaskbar="False"
        SourceInitialized="Window_SourceInitialized">

    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        </Style>

        <!-- Color swatch. Tag is its color box. Click opens the color picker. -->
        <Style x:Key="ColorSwatchStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Pick a color"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="swatch"
                                Background="{Binding Tag.Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToBrushConverter}}"
                                BorderBrush="{DynamicResource Theme.Control.Border}"
                                BorderThickness="1"
                                CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="swatch" Property="BorderBrush" Value="{DynamicResource Theme.Control.Hover.Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sample probe -->
        <Style x:Key="ColorSampleStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="94"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Probe.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Column headers -->
        <Style x:Key="ColorHeaderStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Theme list: built-in themes first, then custom themes -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ThemeList"
                     Height="150"
                     Style="{StaticResource FavoritesListBox}"
                     ItemContainerStyle="{StaticResource FavoritesListBoxItemsStyle}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ThemeList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Description}"
                                       Margin="12,0,2,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource Theme.Text.Secondary}"/>
                            <TextBlock Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Theme buttons -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button Style="{StaticResource ButtonStyle}"
                        Click="DuplicateTheme_Click"
                        Width="85"
                        Content="Duplicate"/>
                <Button x:Name="DeleteThemeButton"
                        Style="{StaticResource ButtonStyle}"
                        Click="DeleteTheme_Click"
                        Width="85"
                        Margin="0,6,0,0"
                        Content="Delete"/>
                <Button x:Name="ImportThemeButton"
                        Style="{StaticResource ButtonStyle}"
                        Width="85"
                        Margin="0,18,0,0"
                        Content="Import..."
                        IsEnabled="False"/>
                <Button x:Name="ExportThemeButton"
                        Style="{StaticResource ButtonStyle}"
                        Width="85"
                        Margin="0,6,0,0"
                        Content="Export..."
                        IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- Theme name, for custom themes. Built-in themes show a note in its place. -->
        <DockPanel x:Name="ThemeNamePanel"
                   Grid.Row="1"
                   Margin="0,10,93,0">
            <TextBlock Text="Name"
                       Width="50"/>
            <TextBox x:Name="ThemeName"
                     MaxLength="50"
                     TextChanged="ThemeName_TextChanged"/>
        </DockPanel>
        <TextBlock x:Name="BuiltInNote"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   FontSize="13"
                   Foreground="{DynamicResource Theme.Text.Secondary}"
                   Text="Built-in themes can't be changed. Duplicate one to make your own."
                   Visibility="Hidden"/>

        <!-- Colors: one row per status, with a sample probe, then background, text and statistics -->
        <Grid Grid.Row="2"
              Margin="0,22,0,0"
              Name="ProbeColorGrid">
            <Grid.Resources>
                <!-- Color boxes -->
                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource HtmlTextBoxStyle}">
                    <Setter Property="Width" Value="68"/>
                    <EventSetter Event="PreviewTextInput" Handler="HtmlColor_PreviewTextInput"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Column headers -->
            <TextBlock Grid.Column="1" Text="Background" Style="{StaticResource ColorHeaderStyle}" Margin="16,0,0,0"/>
            <TextBlock Grid.Column="2" Text="Text" Style="{StaticResource ColorHeaderStyle}" Margin="16,0,0,0"/>
            <TextBlock Grid.Column="3" Text="Statistics" Style="{StaticResource ColorHeaderStyle}" Margin="16,0,0,0"/>

            <!-- Inactive -->
            <Border Grid.Row="1" Style="{StaticResource ColorSampleStyle}" Background="{Binding Text, ElementName=ProbeBackgroundInactive, Converter={StaticResource StringToBrushConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="↑3" FontSize="12" Margin="5,0,0,0" Foreground="{Binding Text, ElementName=StatisticsForegroundInactive, Converter={StaticResource StringToBrushConverter}}"/>
                    <TextBlock Text="Inactive" FontSize="12" Foreground="{Binding Text, ElementName=ProbeForegroundInactive, Converter={StaticResource StringToBrushConverter}}"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=ProbeBackgroundInactive}" Click="ColorSwatch_Click"/>
                <TextBox Name="ProbeBackgroundInactive" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=ProbeForegroundInactive}" Click="ColorSwatch_Click"/>
                <TextBox Name="ProbeForegroundInactive" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=StatisticsForegroundInactive}" Click="ColorSwatch_Click"/>
                <TextBox Name="StatisticsForegroundInactive" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- Up -->
            <Border Grid.Row="2" Style="{StaticResource ColorSampleStyle}" Background="{Binding Text, ElementName=ProbeBackgroundUp, Converter={StaticResource StringToBrushConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="↑3" FontSize="12" Margin="5,0,0,0" Foreground="{Binding Text, ElementName=StatisticsForegroundUp, Converter={StaticResource StringToBrushConverter}}"/>
                    <TextBlock Text="Up" FontSize="12" Foreground="{Binding Text, ElementName=ProbeForegroundUp, Converter={StaticResource StringToBrushConverter}}"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=ProbeBackgroundUp}" Click="ColorSwatch_Click"/>
                <TextBox Name="ProbeBackgroundUp" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=ProbeForegroundUp}" Click="ColorSwatch_Click"/>
                <TextBox Name="ProbeForegroundUp" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=StatisticsForegroundUp}" Click="ColorSwatch_Click"/>
                <TextBox Name="StatisticsForegroundUp" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- Down -->
            <Border Grid.Row="3" Style="{StaticResource ColorSampleStyle}" Background="{Binding Text, ElementName=ProbeBackgroundDown, Converter={StaticResource StringToBrushConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="↑3" FontSize="12" Margin="5,0,0,0" Foreground="{Binding Text, ElementName=StatisticsForegroundDown, Converter={StaticResource StringToBrushConverter}}"/>
                    <TextBlock Text="Down" FontSize="12" Foreground="{Binding Text, ElementName=ProbeForegroundDown, Converter={StaticResource StringToBrushConverter}}"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=ProbeBackgroundDown}" Click="ColorSwatch_Click"/>
                <TextBox Name="ProbeBackgroundDown" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=ProbeForegroundDown}" Click="ColorSwatch_Click"/>
                <TextBox Name="ProbeForegroundDown" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=StatisticsForegroundDown}" Click="ColorSwatch_Click"/>
                <TextBox Name="StatisticsForegroundDown" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- Warning -->
            <Border Grid.Row="4" Style="{StaticResource ColorSampleStyle}" Background="{Binding Text, ElementName=ProbeBackgroundIndeterminate, Converter={StaticResource StringToBrushConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="↑3" FontSize="12" Margin="5,0,0,0" Foreground="{Binding Text, ElementName=StatisticsForegroundIndeterminate, Converter={StaticResource StringToBrushConverter}}"/>
                    <TextBlock Text="Warning" FontSize="12" Foreground="{Binding Text, ElementName=ProbeForegroundIndeterminate, Converter={StaticResource StringToBrushConverter}}"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=ProbeBackgroundIndeterminate}" Click="ColorSwatch_Click"/>
                <TextBox Name="ProbeBackgroundIndeterminate" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=ProbeForegroundIndeterminate}" Click="ColorSwatch_Click"/>
                <TextBox Name="ProbeForegroundIndeterminate" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=StatisticsForegroundIndeterminate}" Click="ColorSwatch_Click"/>
                <TextBox Name="StatisticsForegroundIndeterminate" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- Error -->
            <Border Grid.Row="5" Style="{StaticResource ColorSampleStyle}" Background="{Binding Text, ElementName=ProbeBackgroundError, Converter={StaticResource StringToBrushConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="↑3" FontSize="12" Margin="5,0,0,0" Foreground="{Binding Text, ElementName=StatisticsForegroundError, Converter={StaticResource StringToBrushConverter}}"/>
                    <TextBlock Text="Error" FontSize="12" Foreground="{Binding Text, ElementName=ProbeForegroundError, Converter={StaticResource StringToBrushConverter}}"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=ProbeBackgroundError}" Click="ColorSwatch_Click"/>
                <TextBox Name="ProbeBackgroundError" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=ProbeForegroundError}" Click="ColorSwatch_Click"/>
                <TextBox Name="ProbeForegroundError" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=StatisticsForegroundError}" Click="ColorSwatch_Click"/>
                <TextBox Name="StatisticsForegroundError" Margin="3,0,0,0"/>
            </StackPanel>

            <!-- Tool -->
            <Border Grid.Row="6" Style="{StaticResource ColorSampleStyle}" Background="{Binding Text, ElementName=ProbeBackgroundTool, Converter={StaticResource StringToBrushConverter}}">
                <DockPanel>
                    <TextBlock Text="Tool" FontSize="12" Foreground="{Binding Text, ElementName=ProbeForegroundTool, Converter={StaticResource StringToBrushConverter}}"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=ProbeBackgroundTool}" Click="ColorSwatch_Click"/>
                <TextBox Name="ProbeBackgroundTool" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal" Margin="16,4,0,0">
                <Button Style="{StaticResource ColorSwatchStyle}" Tag="{Binding ElementName=ProbeForegroundTool}" Click="ColorSwatch_Click"/>
                <TextBox Name="ProbeForegroundTool" Margin="3,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- OK and Cancel -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">
            <Button Style="{StaticResource ButtonStyle}"
                    Click="OK_Click"
                    IsDefault="True"
                    Width="85"
                    Content="OK"/>
            <Button Style="{StaticResource ButtonStyle}"
                    IsCancel="True"
                    Width="85"
                    Margin="9,0,0,0"
                    Content="Cancel"/>
        </StackPanel>
    </Grid>
</Window>
