<Window x:Class="vmPing.Views.MultiInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Input addresses"
        UseLayoutRounding="True"
        Height="450" MinHeight="250"
        Width="350" MinWidth="280"
        Background="{DynamicResource Theme.Window.Background}"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized"
        ShowInTaskbar="False">
    
    <Grid Margin="9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel LastChildFill="False">
            <Image DockPanel.Dock="Left" Source="{DynamicResource icon.input-addresses}" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,8,0"/>
            <TextBlock DockPanel.Dock="Left"
                       Text="Enter addresses to ping"
                       Style="{StaticResource OptionHeaderTextStyle}" />
            <Label DockPanel.Dock="Left" Style="{StaticResource LabelToolTip}" Tag="Entering addresses" MaxWidth="250">
                <TextBlock>
                    Enter one address per line, or separate them with commas. To label a host, add # and a name after it.
                    <LineBreak/>
                    <LineBreak/>
                    Have a text file of hosts? Drag and drop it here.
                    <LineBreak/>
                    <LineBreak/>
                    Press Ctrl+Enter to start pinging.
                </TextBlock>
            </Label>
        </DockPanel>

        <!-- Input -->
        <TextBox x:Name="MultiAddress"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 FontFamily="Consolas"
                 FontSize="16"
                 Padding="5"
                 AllowDrop="True"
                 PreviewKeyDown="MultiAddress_PreviewKeyDown"
                 PreviewDragOver="MultiAddress_PreviewDragOver"
                 Drop="MultiAddress_Drop"/>

        <!-- Buttons section -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
            <Button Style="{StaticResource ButtonStyle}"
                    Content="OK"
                    Width="85"
                    IsDefault="True"
                    Click="OK_Click"/>
            <Button Style="{StaticResource ButtonStyle}"
                    Content="Cancel"
                    Width="85"
                    Margin="9,0,0,0"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
