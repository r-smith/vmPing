<Window x:Class="vmPing.Views.NewFavoriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resource="clr-namespace:vmPing.Properties"
        Title="Save as favorite"
        UseLayoutRounding="True"
        Height="Auto"
        Width="400"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.Window.Background}"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="9">
            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <Image Source="{DynamicResource icon.new-favorite}"
                       VerticalAlignment="Center"
                       Width="20"
                       Height="20"
                       Margin="0,0,8,0"/>
                <TextBlock Text="{x:Static resource:Strings.NewFavorite_Header}"
                           Style="{StaticResource ResourceKey=OptionHeaderTextStyle}"/>
            </StackPanel>

            <!-- Title -->
            <TextBlock Text="{x:Static resource:Strings.NewFavorite_Title}"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource Theme.Text}"
                       FontSize="14"/>
            <TextBox x:Name="MyTitle"
                     Margin="0,4,0,0"
                     MaxLength="64"/>

            <!-- Group: pick an existing group, or type a new one. Leave it empty for no group. -->
            <TextBlock Text="Group"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource Theme.Text}"
                       FontSize="14"/>
            <ComboBox x:Name="MyGroup"
                      Margin="0,4,0,0"
                      HorizontalAlignment="Stretch"
                      IsEditable="True"/>

            <!-- What will be saved -->
            <TextBlock x:Name="Summary"
                       Margin="0,12,0,10"
                       Foreground="{DynamicResource Theme.Text.Secondary}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="9,0,9,9">
            <Button Style="{StaticResource ButtonStyle}"
                    IsDefault="True"
                    Margin="0,0,9,0"
                    Click="Save_Click"
                    Width="85"
                    Content="{x:Static resource:Strings.DialogButton_Save}" />
            <Button Style="{StaticResource ButtonStyle}"
                    Width="85"
                    IsCancel="True"
                    Content="{x:Static resource:Strings.DialogButton_Cancel}" />
        </StackPanel>
    </Grid>
</Window>
