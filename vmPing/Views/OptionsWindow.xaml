<Window x:Class="vmPing.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        UseLayoutRounding="True"
        Height="540"
        Width="580"
        MinHeight="500"
        MinWidth="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Theme.Window.Background}"
        SourceInitialized="Window_SourceInitialized">

    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type TextBlock}" x:Key="OptionSubHeaderTextStyle">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl TabStripPlacement="Left" HorizontalContentAlignment="Left">
            <!-- Tab: Monitoring -->
            <TabItem Header="Monitoring" Name="GeneralTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <DockPanel Margin="20,0,20,15" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Monitoring"
                                   Style="{StaticResource OptionHeaderTextStyle}"/>
                        <!-- Ping interval -->
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="0,10,0,0">
                            <TextBlock Text="Ping interval:"
                                       Width="110"/>
                            <TextBox Name="PingInterval"
                                     PreviewTextInput="NumericTextbox_PreviewTextInput"
                                     Width="60"
                                     MaxLength="5"/>
                            <ComboBox Name="PingIntervalUnits" Width="100" Margin="10,0,0,0">
                                <ComboBoxItem Content="seconds" IsSelected="True"/>
                                <ComboBoxItem Content="minutes"/>
                                <ComboBoxItem Content="hours"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Ping timeout -->
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="0,10,0,0">
                            <TextBlock Text="Ping timeout:"
                                       Width="110"/>
                            <TextBox Name="PingTimeout"
                                     PreviewTextInput="NumericTextbox_PreviewTextInput"
                                     Width="60"
                                     MaxLength="2"/>
                            <TextBlock Text="seconds"
                                       Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Down detection -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Down detection"
                                   Margin="0,25,0,10"
                                   Style="{StaticResource OptionHeaderTextStyle}"/>
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal">
                            <TextBlock Text="Mark a host down after"/>
                            <TextBox Name="AlertThreshold"
                                     PreviewTextInput="NumericTextbox_PreviewTextInput"
                                     Width="60"
                                     Margin="8,0"
                                     MaxLength="2"/>
                            <TextBlock Text="missed replies"/>
                        </StackPanel>

                        <!-- High latency detection -->
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,25,0,10">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="High latency detection"
                                       Margin="0"
                                       Style="{StaticResource OptionHeaderTextStyle}"/>
                            <Label DockPanel.Dock="Left" Style="{StaticResource LabelToolTip}" Tag="High latency detection">
                                <TextBlock>
                                    Get an alert when a host is still up but replying slowly.
                                    <LineBreak/>
                                    <LineBreak/>
                                    <Bold>Dynamic:</Bold> a reply is slow when it takes longer than the host's fastest reply plus the threshold.
                                    <LineBreak/>
                                    <LineBreak/>
                                    <Bold>Fixed:</Bold> a reply is slow when it takes as long as the threshold or longer.
                                </TextBlock>
                            </Label>
                        </DockPanel>

                        <!-- Latency mode -->
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal">
                            <RadioButton GroupName="LatencyMode"
                                         Name="LatencyOffOption"
                                         Content="Off"
                                         IsChecked="True"/>
                            <RadioButton GroupName="LatencyMode"
                                         Name="LatencyDynamicOption"
                                         Content="Dynamic"
                                         Margin="24,0,0,0"/>
                            <RadioButton GroupName="LatencyMode"
                                         Name="LatencyFixedOption"
                                         Content="Fixed"
                                         Margin="24,0,0,0"/>
                        </StackPanel>

                        <!-- Threshold and slow reply count. Hidden when latency mode is off. -->
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=LatencyOffOption}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Threshold. The words around the box follow the mode. -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,12,0,0">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="Slow when"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=LatencyFixedOption}" Value="True">
                                                    <Setter Property="Text" Value="Slow when a reply takes"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Name="HighLatencyMilliseconds"
                                         PreviewTextInput="NumericTextbox_PreviewTextInput"
                                         Width="60"
                                         Margin="8,0"
                                         MaxLength="5"/>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="ms slower than its fastest reply"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=LatencyFixedOption}" Value="True">
                                                    <Setter Property="Text" Value="ms or longer"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Slow reply count -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <TextBlock Text="Mark a host slow after"/>
                                <TextBox Name="HighLatencyTriggerCount"
                                         PreviewTextInput="NumericTextbox_PreviewTextInput"
                                         Width="60"
                                         Margin="8,0"
                                         MaxLength="2"/>
                                <TextBlock Text="slow replies"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Advanced -->
            <TabItem Header="Advanced" Name="AdvancedTab">
                <DockPanel Margin="20,0" LastChildFill="False">

                    <!-- Header -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Advanced ping options"
                               Style="{StaticResource OptionHeaderTextStyle}"/>

                    <!-- TTL -->
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <TextBlock Text="Time to live:"
                                   Width="110"/>
                        <TextBox Name="TTL"
                                 PreviewTextInput="NumericTextbox_PreviewTextInput"
                                 Width="80"
                                 MaxLength="3"/>
                        <TextBlock Text="hops"
                                   Margin="10,0,0,0"/>
                        <Label Style="{StaticResource LabelToolTip}" Tag="Time to live">
                            How many routers a ping can pass through before it's dropped. Each router along the way counts as one hop.
                        </Label>
                    </StackPanel>

                    <!-- Separator -->
                    <Separator DockPanel.Dock="Top" Height="1" Background="{DynamicResource Theme.Panel.Border}" Margin="0,20"/>

                    <!-- Packet size -->
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0">
                        <RadioButton GroupName="IcmpData"
                                     Content="Data size"
                                     Name="PacketSizeOption"
                                     Checked="PacketSizeOption_Checked"
                                     IsChecked="True"
                                     Width="160"/>
                        <TextBox Name="PacketSize"
                                 PreviewTextInput="NumericTextbox_PreviewTextInput"
                                 TextChanged="PacketData_TextChanged"
                                 Width="80"
                                 MaxLength="5"
                                 Visibility="{Binding IsChecked, ElementName=PacketSizeOption, Converter={StaticResource BooleanToHiddenVisibilityConverter}}"/>
                        <TextBlock Text="bytes" Margin="10,0,0,0"
                                   Visibility="{Binding IsChecked, ElementName=PacketSizeOption, Converter={StaticResource BooleanToHiddenVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Packet data -->
                    <DockPanel DockPanel.Dock="Top"
                                Margin="0,7,0,0">
                        <RadioButton GroupName="IcmpData"
                                     Content="Custom data"
                                     Name="UseCustomPacketOption"
                                     Checked="UseCustomPacketOption_Checked"
                                     DockPanel.Dock="Left"
                                     VerticalAlignment="Top"
                                     Width="160"/>
                        <TextBox Name="PacketData"
                                 TextChanged="PacketData_TextChanged"
                                 Height="80"
                                 DockPanel.Dock="Right"
                                 VerticalContentAlignment="Top"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxLength="65500"
                                 Visibility="{Binding IsChecked, ElementName=UseCustomPacketOption, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </DockPanel>

                    <!-- Total packet size -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,15,0,0">
                        <TextBlock Foreground="{DynamicResource Theme.Text.Secondary}"
                                   Text="Total packet size:"/>
                        <TextBlock Foreground="{DynamicResource Theme.Text.Secondary}"
                                   Name="Bytes"
                                   Margin="6,0,4,0"
                                   Text="64"/>
                        <TextBlock Foreground="{DynamicResource Theme.Text.Secondary}"
                                   Text="bytes"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Separator DockPanel.Dock="Top" Height="1" Background="{DynamicResource Theme.Panel.Border}" Margin="0,20"/>

                    <!-- Fragment / Don't fragment -->
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left"
                                  Name="DontFragment"
                                  Content="Don't fragment"/>
                        <Label DockPanel.Dock="Left" Style="{StaticResource LabelToolTip}" Tag="Don't fragment">
                            <TextBlock>
                                Tells routers to drop a packet that's too big instead of splitting it up.
                                <LineBreak/>
                                <LineBreak/>
                                Tip: turn this on and adjust the packet size to find the largest packet your network can carry (the MTU).
                            </TextBlock>
                        </Label>
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <!-- Tab: Popups -->
            <TabItem Header="Popups" Name="PopupAlertsTab">
                <DockPanel Margin="20,0" LastChildFill="False">

                    <!-- Header -->
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Popup alerts"
                                   Style="{StaticResource OptionHeaderTextStyle}"/>
                        <Label DockPanel.Dock="Left" Style="{StaticResource LabelToolTip}" Tag="Popup alerts">
                            <TextBlock>
                                A small popup appears in the lower-right corner of your screen when a host goes down or comes back up.
                                <LineBreak/>
                                <LineBreak/>
                                Show them always, only while vmPing is minimized, or turn them off.
                            </TextBlock>
                        </Label>
                    </DockPanel>


                    <!-- Popup notification option radio button group -->
                    <RadioButton DockPanel.Dock="Top"
                                 GroupName="PopupAlerts"
                                 Content="Disabled"
                                 Name="PopupsDisabledOption"
                                 Margin="0,15,0,0"/>
                    <RadioButton DockPanel.Dock="Top"
                                 GroupName="PopupAlerts"
                                 Content="Show when minimized"
                                 Name="PopupsMinimizedOption"
                                 Margin="0,6"/>
                    <RadioButton DockPanel.Dock="Top"
                                 GroupName="PopupAlerts"
                                 Content="Always show"
                                 Name="PopupsAlwaysOption"
                                 IsChecked="True"/>

                    <!-- Auto-dismiss enabled checkbox -->
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,20,0,5">
                        <CheckBox DockPanel.Dock="Left"
                                  Name="IsAutoDismissEnabled"
                                  Content="Auto-dismiss notifications"
                                  IsChecked="True"/>
                        <Label DockPanel.Dock="Left" Style="{StaticResource LabelToolTip}" Tag="Auto-dismiss notifications">
                            Close popup alerts automatically after the number of seconds you choose.
                        </Label>
                    </DockPanel>

                    <!-- Auto-dismiss interval textbox -->
                    <StackPanel DockPanel.Dock="Top"
                                Visibility="{Binding IsChecked, ElementName=IsAutoDismissEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="50,0,0,0"
                                Orientation="Horizontal">
                        <TextBox Name="AutoDismissInterval"
                                 PreviewTextInput="NumericTextbox_PreviewTextInput"
                                 Width="60"
                                 MaxLength="2"/>
                        <TextBlock Text="seconds"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </TabItem>

            <!-- Tab: Email Alerts -->
            <TabItem Header="Email" Name="EmailAlertsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <DockPanel Margin="20,0,20,15">

                        <!-- Header -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Email alerts"
                                   Style="{StaticResource OptionHeaderTextStyle}"/>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,15,0,15">
                            <CheckBox DockPanel.Dock="Top"
                                      Name="IsEmailAlertsEnabled"
                                      Content="Enable email alerts"
                                      Click="IsEmailAlertsEnabled_Click"
                                      IsChecked="True"/>
                            <Label Style="{StaticResource LabelToolTip}" Tag="Enable email alerts">
                                Send an email every time a host goes down or comes back up.
                            </Label>
                        </StackPanel>

                        <DockPanel LastChildFill="False"
                                   DockPanel.Dock="Top"
                                   Margin="0"
                                   Visibility="{Binding IsChecked, ElementName=IsEmailAlertsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,12,0"/>
                                </Style>
                                <Style TargetType="{x:Type DockPanel}">
                                    <Setter Property="Margin" Value="0,3,0,3"/>
                                    <Setter Property="DockPanel.Dock" Value="Top"/>
                                </Style>
                            </DockPanel.Resources>

                            <!-- Server information subheading -->
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Server information"
                                       Style="{StaticResource OptionSubHeaderTextStyle}"/>

                            <!-- SMTP Server-->
                            <DockPanel>
                                <Grid Width="120">
                                    <TextBlock Text="SMTP server"/>
                                </Grid>
                                <TextBox Name="SmtpServer"/>
                            </DockPanel>

                            <!-- Smtp Port -->
                            <DockPanel>
                                <Grid Width="120">
                                    <TextBlock Text="Port"/>
                                </Grid>
                                <TextBox Name="SmtpPort"
                                         PreviewTextInput="NumericTextbox_PreviewTextInput"
                                         HorizontalAlignment="Left"
                                         MaxLength="5"
                                         Width="75"/>
                                <CheckBox Name="IsSmtpSslEnabled"
                                          Content="Use STARTTLS"
                                          FontSize="13"
                                          Margin="50,0,0,0"/>
                            </DockPanel>

                            <!-- Smtp User. Authentication is used when a username is entered. -->
                            <DockPanel>
                                <Grid Width="120">
                                    <TextBlock Text="Username"/>
                                </Grid>
                                <Grid>
                                    <TextBox Name="SmtpUsername"/>
                                    <!-- Placeholder, shown while the username is empty -->
                                    <TextBlock Text="(optional)"
                                               Margin="6,0,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{DynamicResource Theme.Text.Disabled}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=SmtpUsername, Path=Text}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>

                            <!-- Smtp Password -->
                            <DockPanel>
                                <Grid Width="120">
                                    <TextBlock Text="Password"/>
                                </Grid>
                                <Grid>
                                    <PasswordBox Name="SmtpPassword"
                                                 PasswordChanged="SmtpPassword_PasswordChanged"/>
                                    <!-- Placeholder, shown while the password is empty. PasswordChanged shows and hides it. -->
                                    <TextBlock x:Name="SmtpPasswordPlaceholder"
                                               Text="(optional)"
                                               Margin="6,0,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{DynamicResource Theme.Text.Disabled}"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </DockPanel>

                            <!-- Email addresses subheading -->
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Email addresses"
                                       Margin="0,12,0,5"
                                       Style="{StaticResource OptionSubHeaderTextStyle}"/>

                            <!-- From Address-->
                            <DockPanel>
                                <Grid Width="120">
                                    <TextBlock Text="From address"/>
                                </Grid>
                                <TextBox Name="EmailFromAddress"/>
                            </DockPanel>

                            <!-- Recipient Address-->
                            <DockPanel>
                                <Grid Width="120">
                                    <TextBlock Text="Recipient address"/>
                                </Grid>
                                <TextBox Name="EmailRecipientAddress"
                                         LostFocus="EmailRecipientAddress_LostFocus"/>
                            </DockPanel>

                            <!-- Test button -->
                            <Button Style="{StaticResource ButtonStyle}"
                                    Name="TestEmailButton"
                                    Visibility="{Binding IsChecked, ElementName=IsEmailAlertsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    DockPanel.Dock="Top"
                                    Click="TestEmail_Click"
                                    Padding="15,5"
                                    Margin="0,18,0,0"
                                    Content="Send test email"
                                    HorizontalAlignment="Left"/>
                        </DockPanel>
                    </DockPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Sounds -->
            <TabItem Header="Sounds" Name="AudioAlertTab">
                <DockPanel Margin="20,0">

                    <!-- Header -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Sound alerts"
                               Style="{StaticResource OptionHeaderTextStyle}"/>

                    <!-- Audio Alert Down: checkbox / tooltip -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,15,0,0">
                        <CheckBox Name="IsAudioDownAlertEnabled"
                                  Click="IsAudioDownAlertEnabled_Click"
                                  Content="Enable audio alert: host down"
                                  IsChecked="True"/>
                        <Label Style="{StaticResource LabelToolTip}" Tag="Audio alert: host down">
                            Play a sound when a host goes down.
                        </Label>
                    </StackPanel>

                    <!-- Audio Alert Down: Filepath / play button / browse button -->
                    <Grid DockPanel.Dock="Top"
                          Margin="30,10,0,0"
                          VerticalAlignment="Top"
                          Visibility="{Binding IsChecked, ElementName=IsAudioDownAlertEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Audio file path"/>
                            <TextBox Name="AudioDownFilePath"
                                     Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <!-- Browse button -->
                                <Button Style="{StaticResource ButtonStyle}"
                                        Click="AudioDownBrowse_Click"
                                        Width="85"
                                        Content="Browse..."/>
                                <!-- Play button -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=AudioDownFilePath}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Button Style="{StaticResource ButtonStyle}"
                                            Click="AudioDownPlay_Click"
                                            Width="85"
                                            Margin="10,0,0,0"
                                            Content="Test">
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Hidden separator -->
                    <Separator DockPanel.Dock="Top" Height="1" Background="Transparent" Margin="0,20,0,0"
                               Visibility="{Binding IsChecked, ElementName=IsAudioDownAlertEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Audio Alert Up: checkbox / tooltip -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,15,0,0">
                        <CheckBox Name="IsAudioUpAlertEnabled"
                                  Click="IsAudioUpAlertEnabled_Click"
                                  Content="Enable audio alert: host up"
                                  IsChecked="True"/>
                        <Label Style="{StaticResource LabelToolTip}" Tag="Audio alert: host up">
                            Play a sound when a host comes back up.
                        </Label>
                    </StackPanel>

                    <!-- Audio Alert Down: Filepath / play button / browse button -->
                    <Grid DockPanel.Dock="Top"
                          Margin="30,10,0,0"
                          VerticalAlignment="Top"
                          Visibility="{Binding IsChecked, ElementName=IsAudioUpAlertEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Audio file path"/>
                            <TextBox Name="AudioUpFilePath"
                                     Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <!-- Browse button -->
                                <Button Style="{StaticResource ButtonStyle}"
                                        Click="AudioUpBrowse_Click"
                                        Width="85"
                                        Content="Browse..."/>
                                <!-- Play button -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=AudioUpFilePath}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Button Style="{StaticResource ButtonStyle}"
                                            Click="AudioUpPlay_Click"
                                            Width="85"
                                            Margin="10,0,0,0"
                                            Content="Test">
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Tab: Logging -->
            <TabItem Header="Logging" Name="LogOutputTab">
                <DockPanel Margin="20,0" LastChildFill="False">

                    <!-- Header -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Logging"
                               Style="{StaticResource OptionHeaderTextStyle}"/>

                    <!-- Log folder -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Log folder"
                               Margin="0,15,0,0"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ButtonStyle}"
                                Click="BrowseLogFolder_Click"
                                Width="85"
                                Margin="8,0,0,0"
                                Content="Browse..."/>
                        <TextBox Name="LogFolder"/>
                    </DockPanel>

                    <!-- Log all ping output -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,20,0,0">
                        <CheckBox Name="IsLogOutputEnabled"
                                  Content="Log ping output"/>
                        <Label Style="{StaticResource LabelToolTip}" Tag="Log ping output">
                            Save each host's ping output to its own text file (hostname.txt) in the log folder.
                        </Label>
                    </StackPanel>

                    <!-- Log status changes -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,15,0,0">
                        <CheckBox Name="IsLogStatusChangesEnabled"
                                  Content="Log status changes"/>
                        <Label Style="{StaticResource LabelToolTip}" Tag="Log status changes">
                            <TextBlock>
                                Record each time a host goes down or comes back up in vmPing-status.txt in the log folder.
                                <LineBreak/>
                                <LineBreak/>
                                The file is tab separated, so it opens neatly in Excel or imports into a database.
                            </TextBlock>
                        </Label>
                    </StackPanel>
                </DockPanel>
            </TabItem>

            <!-- Tab: Window -->
            <TabItem Header="Window" Name="WindowTab">
                <DockPanel Margin="20,0" LastChildFill="False">

                    <!-- Header -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Window"
                               Style="{StaticResource OptionHeaderTextStyle}"/>

                    <!-- Always on top -->
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,15,0,0">
                        <CheckBox DockPanel.Dock="Left"
                                  Name="IsAlwaysOnTopEnabled"
                                  Content="Always on top"/>
                        <Label DockPanel.Dock="Left" Style="{StaticResource LabelToolTip}" Tag="Always on top">
                            Keep vmPing visible above your other windows.
                        </Label>
                    </DockPanel>
                    <!-- Minimze to tray -->
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,15,0,0">
                        <CheckBox DockPanel.Dock="Left"
                                  Name="IsMinimizeToTrayEnabled"
                                  Content="Minimize to tray"/>
                        <Label DockPanel.Dock="Left" Style="{StaticResource LabelToolTip}" Tag="Minimize to tray">
                            <TextBlock>
                                Minimizing vmPing sends it to the system tray instead of the taskbar. Click the tray icon to bring it back.
                                <LineBreak/>
                                <LineBreak/>
                                Can't see the icon? Windows may hide it under the ^ arrow. To keep it showing, open the taskbar settings and turn vmPing on under the system tray icons. (Steps vary by Windows version.)
                            </TextBlock>
                        </Label>
                    </DockPanel>
                    <!-- Close to tray -->
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,15,0,0">
                        <CheckBox DockPanel.Dock="Left"
                                  Name="IsExitToTrayEnabled"
                                  Content="Close to tray"/>
                        <Label DockPanel.Dock="Left" Style="{StaticResource LabelToolTip}" Tag="Close to tray">
                            <TextBlock>
                                Closing the window keeps vmPing running in the system tray. To quit, right-click the tray icon and choose Exit vmPing.
                                <LineBreak/>
                                <LineBreak/>
                                Can't see the icon? Windows may hide it under the ^ arrow. To keep it showing, open the taskbar settings and turn vmPing on under the system tray icons. (Steps vary by Windows version.)
                            </TextBlock>
                        </Label>
                    </DockPanel>
                    <!-- Always show tray icon -->
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,15,0,0">
                        <CheckBox DockPanel.Dock="Left"
                                  Name="IsAlwaysShowTrayIconEnabled"
                                  Content="Always show tray icon"/>
                        <Label DockPanel.Dock="Left" Style="{StaticResource LabelToolTip}" Tag="Always show tray icon">
                            Keep vmPing's icon in the system tray all the time, not just when it's minimized or closed to the tray. Click the icon to bring vmPing to the front.
                        </Label>
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <!-- Tab: Startup -->
            <TabItem Header="Startup" Name="StartupTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <DockPanel Margin="20,0,20,15" LastChildFill="False">

                        <!-- Header -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Startup"
                                   Style="{StaticResource OptionHeaderTextStyle}"/>

                        <!-- Startup mode selection -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="When vmPing opens:"
                                   Margin="0,0,0,5"/>
                        <ComboBox DockPanel.Dock="Top"
                                  Name="StartupMode"
                                  Width="240">
                            <ComboBoxItem Content="Show empty probes" Tag="Standard" IsSelected="True"/>
                            <ComboBoxItem Content="Open the multi-input window" Tag="Standard"/>
                            <ComboBoxItem Content="Load a favorite" Tag="Favorite"/>
                        </ComboBox>
                        <!-- Initial probe / column count -->
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="0,13,0,0">
                            <!-- Style to control visibility based on selected startup mode -->
                            <StackPanel.Style>
                                <Style>
                                    <Setter Property="StackPanel.Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=StartupMode, Path=SelectedItem.Tag}" Value="Standard">
                                            <Setter Property="StackPanel.Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!-- Probe count -->
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Text="Probes:"
                                           Margin="0,0,0,4"/>
                                <TextBox Name="InitialProbeCount"
                                         PreviewTextInput="NumericTextbox_PreviewTextInput"
                                         Width="60"
                                         HorizontalAlignment="Left"
                                         MaxLength="2"/>
                            </StackPanel>
                            <!-- Column count-->
                            <StackPanel>
                                <TextBlock Text="Columns:"
                                           Margin="0,0,0,4"/>
                                <TextBox Name="InitialColumnCount"
                                         PreviewTextInput="NumericTextbox_PreviewTextInput"
                                         Width="60"
                                         HorizontalAlignment="Left"
                                         MaxLength="2"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Select a favorite -->
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="0,13,0,0">
                            <!-- Style to control visibility based on selected startup mode -->
                            <StackPanel.Style>
                                <Style>
                                    <Setter Property="StackPanel.Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=StartupMode, Path=SelectedItem.Tag}" Value="Favorite">
                                            <Setter Property="StackPanel.Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!-- Favorite selection -->
                            <StackPanel Margin="0,0,35,0">
                                <TextBlock Text="Select a favorite:"
                                           Margin="0,0,0,4"/>
                                <ComboBox DockPanel.Dock="Top"
                                          Name="InitialFavorite"
                                          Width="250">
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- Start minimized -->
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,20,0,0">
                            <CheckBox DockPanel.Dock="Left"
                                      Name="IsStartMinimizedEnabled"
                                      Content="Start minimized"/>
                            <Label DockPanel.Dock="Left" Style="{StaticResource LabelToolTip}" Tag="Start minimized">
                                <TextBlock>
                                    Open vmPing minimized to the taskbar.
                                    <LineBreak/>
                                    <LineBreak/>
                                    If Minimize to tray is also on, vmPing starts hidden in the system tray instead.
                                    <LineBreak/>
                                    <LineBreak/>
                                    This only applies to the first copy. If vmPing is already running, a new copy opens normally.
                                </TextBlock>
                            </Label>
                        </DockPanel>

                        <!-- Window size -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Window size:"
                                   Margin="0,20,0,5"/>
                        <RadioButton DockPanel.Dock="Top"
                                     GroupName="WindowSize"
                                     Name="WindowSizeRememberOption"
                                     Content="Remember the last size"
                                     Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal">
                            <RadioButton GroupName="WindowSize"
                                         Name="WindowSizeFixedOption"
                                         Content="Fixed size:"
                                         IsChecked="True"
                                         Width="150"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="Width"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <TextBox Name="FixedWindowWidth"
                                     PreviewTextInput="NumericTextbox_PreviewTextInput"
                                     IsEnabled="{Binding ElementName=WindowSizeFixedOption, Path=IsChecked}"
                                     Width="60"
                                     MaxLength="4"/>
                            <TextBlock Text="Height"
                                       VerticalAlignment="Center"
                                       Margin="15,0,5,0"/>
                            <TextBox Name="FixedWindowHeight"
                                     PreviewTextInput="NumericTextbox_PreviewTextInput"
                                     IsEnabled="{Binding ElementName=WindowSizeFixedOption, Path=IsChecked}"
                                     Width="60"
                                     MaxLength="4"/>
                        </StackPanel>

                        <!-- Window position -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Window position:"
                                   Margin="0,20,0,5"/>
                        <RadioButton DockPanel.Dock="Top"
                                     GroupName="WindowPosition"
                                     Name="WindowPositionDefaultOption"
                                     Content="Let Windows choose"
                                     IsChecked="True"/>
                        <RadioButton DockPanel.Dock="Top"
                                     GroupName="WindowPosition"
                                     Name="WindowPositionRememberOption"
                                     Content="Remember the last position"
                                     Margin="0,6"/>
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal">
                            <RadioButton GroupName="WindowPosition"
                                         Name="WindowPositionFixedOption"
                                         Content="Fixed position:"
                                         Width="150"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="Left"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <TextBox Name="FixedWindowLeft"
                                     PreviewTextInput="SignedNumericTextbox_PreviewTextInput"
                                     IsEnabled="{Binding ElementName=WindowPositionFixedOption, Path=IsChecked}"
                                     Width="60"
                                     MaxLength="5"/>
                            <TextBlock Text="Top"
                                       VerticalAlignment="Center"
                                       Margin="15,0,5,0"/>
                            <TextBox Name="FixedWindowTop"
                                     PreviewTextInput="SignedNumericTextbox_PreviewTextInput"
                                     IsEnabled="{Binding ElementName=WindowPositionFixedOption, Path=IsChecked}"
                                     Width="60"
                                     MaxLength="5"/>
                        </StackPanel>
                    </DockPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Theme -->
            <TabItem Header="Theme" Name="ThemeTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <DockPanel LastChildFill="False"
                               Name="ThemeDockPanel"
                               Margin="20,0,20,20">
                        <DockPanel.Resources>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Orientation" Value="Horizontal"/>
                                <Setter Property="Margin" Value="0,5,0,0"/>
                                <Setter Property="DockPanel.Dock" Value="Top"/>
                            </Style>
                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource HtmlTextBoxStyle}">
                                <EventSetter Event="PreviewTextInput" Handler="HtmlColor_PreviewTextInput"/>
                            </Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Control.Border}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Width" Value="80"/>
                                <Setter Property="Margin" Value="15,0,0,0"/>
                            </Style>
                        </DockPanel.Resources>

                        <!-- Header -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Theme"
                                   Style="{StaticResource OptionHeaderTextStyle}"/>

                        <!-- Theme option radio button group -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Light or dark"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource OptionSubHeaderTextStyle}"/>
                        <RadioButton DockPanel.Dock="Top"
                                     GroupName="Theme"
                                     Content="Use Windows setting"
                                     Name="ThemeSystemOption"
                                     Margin="0,6,0,0"/>
                        <RadioButton DockPanel.Dock="Top"
                                     GroupName="Theme"
                                     Content="Light"
                                     Name="ThemeLightOption"
                                     Margin="0,6,0,0"/>
                        <RadioButton DockPanel.Dock="Top"
                                     GroupName="Theme"
                                     Content="Dark"
                                     Name="ThemeDarkOption"
                                     Margin="0,6,0,0"/>

                        <!-- Probe layout -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Probe layout"
                                   Margin="0,20,0,0"
                                   Style="{StaticResource OptionSubHeaderTextStyle}"/>
                        <!-- Space between probes -->
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,6,0,0">
                            <CheckBox DockPanel.Dock="Left"
                                      Name="IsProbeSpacingEnabled"
                                      Content="Space between probes"/>
                            <Label DockPanel.Dock="Left" Style="{StaticResource LabelToolTip}" Tag="Space between probes">
                                Add a small gap between probes and round their corners. Turn it off to fit probes edge to edge, with a thin line between them.
                            </Label>
                        </DockPanel>

                        <!-- Probe colors: which theme's set to edit -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Probe colors"
                                   Margin="0,20,0,0"
                                   Style="{StaticResource OptionSubHeaderTextStyle}"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Edit colors for:"
                                       Margin="0,0,15,0"/>
                            <RadioButton GroupName="ProbeColorSet"
                                         Name="LightColorsOption"
                                         Content="Light theme"
                                         Checked="ProbeColorSet_Checked"/>
                            <RadioButton GroupName="ProbeColorSet"
                                         Name="DarkColorsOption"
                                         Content="Dark theme"
                                         Margin="20,0,0,0"
                                         Checked="ProbeColorSet_Checked"/>
                        </StackPanel>

                        <!-- Probe background colors -->
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Probe background"
                                   Margin="0,20,0,0"
                                   Style="{StaticResource OptionSubHeaderTextStyle}"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Inactive"/>
                            <TextBox Name="ProbeBackgroundInactive"/>
                            <Border Background="{Binding ElementName=ProbeBackgroundInactive, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Up"/>
                            <TextBox Name="ProbeBackgroundUp"/>
                            <Border Background="{Binding ElementName=ProbeBackgroundUp, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Down"/>
                            <TextBox Name="ProbeBackgroundDown"/>
                            <Border Background="{Binding ElementName=ProbeBackgroundDown, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Warning"/>
                            <TextBox Name="ProbeBackgroundIndeterminate"/>
                            <Border Background="{Binding ElementName=ProbeBackgroundIndeterminate, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Error"/>
                            <TextBox Name="ProbeBackgroundError"/>
                            <Border Background="{Binding ElementName=ProbeBackgroundError, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Tool"/>
                            <TextBox Name="ProbeBackgroundTool"/>
                            <Border Background="{Binding ElementName=ProbeBackgroundTool, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>

                        <!-- Probe text colors -->
                        <Separator DockPanel.Dock="Top" Height="1" Width="20" Background="Transparent" Margin="0,20,0,0"/>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Probe text"
                                   Margin="0"
                                   Style="{StaticResource OptionSubHeaderTextStyle}"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Inactive"/>
                            <TextBox Name="ProbeForegroundInactive"/>
                            <Border Background="{Binding ElementName=ProbeForegroundInactive, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Up"/>
                            <TextBox Name="ProbeForegroundUp"/>
                            <Border Background="{Binding ElementName=ProbeForegroundUp, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Down"/>
                            <TextBox Name="ProbeForegroundDown"/>
                            <Border Background="{Binding ElementName=ProbeForegroundDown, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Warning"/>
                            <TextBox Name="ProbeForegroundIndeterminate"/>
                            <Border Background="{Binding ElementName=ProbeForegroundIndeterminate, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Error"/>
                            <TextBox Name="ProbeForegroundError"/>
                            <Border Background="{Binding ElementName=ProbeForegroundError, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Tool"/>
                            <TextBox Name="ProbeForegroundTool"/>
                            <Border Background="{Binding ElementName=ProbeForegroundTool, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>

                        <!-- Statistics text colors -->
                        <Separator DockPanel.Dock="Top" Height="1" Width="20" Background="Transparent" Margin="0,20,0,0"/>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Statistics text"
                                   Margin="0"
                                   Style="{StaticResource OptionSubHeaderTextStyle}"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Inactive"/>
                            <TextBox Name="StatisticsForegroundInactive"/>
                            <Border Background="{Binding ElementName=StatisticsForegroundInactive, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Up"/>
                            <TextBox Name="StatisticsForegroundUp"/>
                            <Border Background="{Binding ElementName=StatisticsForegroundUp, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Down"/>
                            <TextBox Name="StatisticsForegroundDown"/>
                            <Border Background="{Binding ElementName=StatisticsForegroundDown, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Width="150" Text="Warning"/>
                            <TextBox Name="StatisticsForegroundIndeterminate"/>
                            <Border Background="{Binding ElementName=StatisticsForegroundIndeterminate, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,10">
                            <TextBlock Width="150" Text="Error"/>
                            <TextBox Name="StatisticsForegroundError"/>
                            <Border Background="{Binding ElementName=StatisticsForegroundError, Path=Text, Converter={StaticResource StringToBrushConverter}}"/>
                        </StackPanel>

                        <!-- Reset colors button -->
                        <Grid DockPanel.Dock="Top" Margin="0,15,0,0">
                            <Button Style="{StaticResource ButtonStyle}"
                                    Click="RestoreDefaultColors_Click"
                                    Padding="15,5"
                                    Content="Reset colors"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </DockPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>


        <!-- Button Section -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Theme.Panel.Border}" Background="{DynamicResource Theme.Panel.Background}" BorderThickness="0,1,0,0">
            <DockPanel Margin="9" HorizontalAlignment="Right">
                <CheckBox DockPanel.Dock="Top"
                          Name="SaveAsDefaults"
                          Content="Keep these settings next time vmPing starts"
                          FontSize="13"
                          HorizontalAlignment="Right"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,9,0,0" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ButtonStyle}"
                            Click="OK_Click"
                            Margin="0,0,9,0"
                            IsDefault="True"
                            Width="85"
                            Content="OK"/>
                    <Button Style="{StaticResource ButtonStyle}"
                            IsCancel="True"
                            Width="85"
                            Content="Cancel"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
