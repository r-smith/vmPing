<Window x:Class="vmPing.Views.StatusHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resource="clr-namespace:vmPing.Properties"
        Title="{x:Static resource:Strings.StatusHistory_WindowTitle}"
        UseLayoutRounding="True"
        Height="400"
        Width="720"
        MinHeight="250"
        MinWidth="620"
        Background="{DynamicResource Theme.Window.Background}"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Status glyph, colored by the kind of change -->
        <Style x:Key="StatusTextStyle" TargetType="{x:Type TextBlock}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_Down}">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Down.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_Error}">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Down.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_Up}">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Up.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_Start}">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Start.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_Stop}">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Stop.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_LatencyHigh}">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.LatencyHigh.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_LatencyNormal}">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.LatencyNormal.Foreground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status tag, colored by the kind of change -->
        <Style x:Key="StatusTagStyle" TargetType="{x:Type Border}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_Down}">
                    <Setter Property="Background" Value="{DynamicResource Theme.Status.Down.Background}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Status.Down.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_Error}">
                    <Setter Property="Background" Value="{DynamicResource Theme.Status.Down.Background}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Status.Down.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_Up}">
                    <Setter Property="Background" Value="{DynamicResource Theme.Status.Up.Background}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Status.Up.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_Start}">
                    <Setter Property="Background" Value="{DynamicResource Theme.Status.Start.Background}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Status.Start.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_Stop}">
                    <Setter Property="Background" Value="{DynamicResource Theme.Status.Stop.Background}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Status.Stop.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_LatencyHigh}">
                    <Setter Property="Background" Value="{DynamicResource Theme.Status.LatencyHigh.Background}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Status.LatencyHigh.Foreground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusAsString}" Value="{x:Static resource:Strings.StatusChange_LatencyNormal}">
                    <Setter Property="Background" Value="{DynamicResource Theme.Status.LatencyNormal.Background}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Theme.Status.LatencyNormal.Foreground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- History DataGrid -->
        <DataGrid Name="StatusHistory"
                  Grid.Row="0"
                  FontSize="16"
                  FontFamily="Consolas"
                  BorderThickness="0"
                  ColumnWidth="SizeToCells"
                  Background="{DynamicResource Theme.Log.Background}"
                  RowBackground="{DynamicResource Theme.Log.Background}"
                  Style="{StaticResource DataGridStyle}">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>

                <!-- Timestamp and status glyph -->
                <DataGridTextColumn Binding="{Binding Timestamp}" Header="Timestamp" MinWidth="90">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="FontWeight" Value="Regular"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusAsGlyph}">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource StatusTextStyle}">
                                                        <Setter Property="Padding" Value="3,2,0,2"/>
                                                        <Setter Property="FontFamily" Value="Marlett"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Timestamp, StringFormat=d }" Foreground="{DynamicResource Theme.Text.Secondary}" Padding="4,2,0,0"/>
                                            <TextBlock Text=" "/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat=T}" Padding="0,2,25,2"/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- Address -->
                <DataGridTextColumn Binding="{Binding Hostname}" Header="Address" MinWidth="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Padding" Value="5,2,25,2"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Alias -->
                <DataGridTextColumn Binding="{Binding Alias}" Header="Alias" MinWidth="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Padding" Value="5,2,25,2"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Status -->
                <DataGridTemplateColumn Header="Status" Width="*" SortMemberPath="StatusAsString">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatusTagStyle}">
                                <TextBlock Text="{Binding StatusAsString}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

        </DataGrid>
        
        <!-- Filter section -->
        <Border Grid.Row="1"
                Background="{DynamicResource Theme.Panel.Background}"
                BorderBrush="{DynamicResource Theme.Panel.Border}"
                BorderThickness="0,1,0,0">
            <!-- Filter section -->
            <DockPanel DockPanel.Dock="Left" Margin="12,6,6,9">
                <!-- Filter -->
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Filter" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,0,0,2"/>
                    <!-- Filter -->
                    <Grid>
                        <!-- Textbox -->
                        <TextBox x:Name="FilterField"
                                 Width="260"
                                 KeyUp="TextBox_KeyUp"/>
                        <!-- Clear button -->
                        <Button HorizontalAlignment="Right"
                                Width="20"
                                Margin="1"
                                Click="FilterClear_Click"
                                Focusable="False"
                                IsTabStop="False">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="#00000000"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Theme.Item.Hover.Background}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding Path=Text, ElementName=FilterField}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{DynamicResource icon.delete}" Width="13" Height="13"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
                <!-- Filter checkbox options -->
                <StackPanel Margin="15,0,0,0">
                    <TextBlock Text="Include" Foreground="{DynamicResource Theme.Text.Secondary}" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="90">
                            <CheckBox x:Name="FilterUp"
                                      Content="Up"
                                      IsChecked="True"
                                      Click="Filter_Click"/>
                        </Grid>
                        <Grid Width="90">
                            <CheckBox x:Name="FilterStart"
                                      Content="Start"
                                      IsChecked="True"
                                      Click="Filter_Click"/>
                        </Grid>
                        <Grid>
                            <CheckBox x:Name="FilterLatency"
                                      Content="Latency"
                                      IsChecked="True"
                                      Click="Filter_Click"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="90">
                            <CheckBox x:Name="FilterDown"
                                      Content="Down"
                                      IsChecked="True"
                                      Click="Filter_Click"/>
                        </Grid>
                        <CheckBox x:Name="FilterStop"
                                  Content="Stop"
                                  IsChecked="True"
                                  Click="Filter_Click" />
                    </StackPanel>
                </StackPanel>
                <!-- Export button -->
                <StackPanel DockPanel.Dock="Left" Margin="25,0,0,0" HorizontalAlignment="Left">
                    <TextBlock Margin="0,0,0,2"/>
                    <Button Style="{StaticResource ButtonStyle}"
                            Content="Export"
                            Click="Export_Click"
                            Width="100"/>
                </StackPanel>
            </DockPanel>
        </Border>
        
        <!-- Overlay for no items in history -->
        <Border Background="{DynamicResource Theme.Log.Background}" Grid.Row="0">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Items.Count, ElementName=StatusHistory}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource Theme.Splash.Yellow}"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           Text="{x:Static resource:Strings.StatusHistory_NoChanges}" />
                <TextBlock Foreground="{DynamicResource Theme.Text.Secondary}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="{x:Static resource:Strings.StatusHistory_NoChangesDescription}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
