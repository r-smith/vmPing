<Window x:Class="vmPing.Views.TracerouteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:vmPing.Views"
        xmlns:converters="clr-namespace:vmPing.Converters"
        UseLayoutRounding="True"
        Title="Traceroute"
        Height="460"
        Width="520"
        MinHeight="300"
        MinWidth="350"
        Background="{DynamicResource Theme.Window.Background}"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- Value converters -->
        <converters:BoolToStringConverter x:Key="BoolToStringConverter" FalseValue="Trace" TrueValue="Stop"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- Hostname textbox -->
        <Style x:Key="HostnameTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>


    <DockPanel LastChildFill="True" Margin="15">
        <TextBlock DockPanel.Dock="Top"
                   Style="{StaticResource ResourceKey=OptionHeaderTextStyle}"
                   Margin="0,5,0,10"
                   Text="Trace route to destination"/>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Hostname textbox -->
            <TextBox Name="Hostname"
                     FontSize="20"
                     Padding="3,2"
                     FontWeight="Regular"
                     FontFamily="Consolas"
                     Style="{StaticResource HostnameTextBoxStyle}"
                     IsEnabled="{Binding IsActive, Converter={StaticResource InverseBooleanConverter}}"/>
            <!-- Placeholder, shown in the empty hostname box while it has focus -->
            <TextBlock Text="Enter target address"
                       FontSize="12"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI"
                       Foreground="{DynamicResource Theme.Text.Secondary}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Padding="10,0,0,0"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Hidden"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ElementName=Hostname, Path=Text}" Value=""/>
                                    <Condition Binding="{Binding ElementName=Hostname, Path=IsKeyboardFocused}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Trace Route button -->
            <Button Name="Trace"
                    Click="Trace_Click"
                    Grid.Column="1"
                    IsDefault="True"
                    IsCancel="{Binding IsActive}"
                    FontSize="14"
                    Padding="0,6"
                    Margin="10,0,0,0"
                    Width="100"
                    Content="Trace"
                    Foreground="{DynamicResource Theme.Text}"
                    FocusVisualStyle="{StaticResource FocusVisual}"
                    Background="{DynamicResource Theme.Control.Background}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="TraceButtonBorder" BorderThickness="1" BorderBrush="{DynamicResource Theme.Control.Border}"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Margin="0,0,8,0" Width="16" Height="16">
                                    <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Setter Property="Source" Value="{DynamicResource icon.stop-circle}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Source" Value="{DynamicResource icon.play}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStringConverter}}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TraceButtonBorder" Property="Background" Value="{DynamicResource Theme.Control.Hover.Background}"/>
                                <Setter TargetName="TraceButtonBorder" Property="BorderBrush" Value="{DynamicResource Theme.Control.Hover.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TraceButtonBorder" Property="Background" Value="{DynamicResource Theme.Control.Pressed.Background}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Status indicator-->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Theme.Panel.Background}" BorderBrush="{DynamicResource Theme.Panel.Border}" BorderThickness="1,1,1,1" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <TextBlock Text=""
                       Visibility="Collapsed"
                       Name="TraceStatus"
                       Margin="9,3"
                       Foreground="{DynamicResource Theme.Splash.Yellow}"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Opacity)"
                                                             From="1" To=".2"
                                                             BeginTime="0:0:0.0"
                                                             Duration="0:0:0.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Opacity)"
                                                             From="1" To="1" Duration="0:0:0.0" FillBehavior="HoldEnd"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Trace result data -->
        <DataGrid Name="TraceData"
                  DockPanel.Dock="Top"
                  Margin="0,20,0,0"
                  Padding="0"
                  CanUserSortColumns="False"
                  ColumnWidth="SizeToCells"
                  BorderBrush="{DynamicResource Theme.Panel.Border}"
                  BorderThickness="1,1,1,0"
                  FontSize="17"
                  FontFamily="Consolas"
                  Background="{DynamicResource Theme.Log.Background}"
                  RowBackground="{DynamicResource Theme.Log.Background}"
                  Style="{StaticResource DataGridStyle}">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>

                <!-- Hop ID -->
                <DataGridTextColumn Binding="{Binding HopId}" Header="Hop" Width="50" MinWidth="40">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="FontWeight"  Value="Regular"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Padding" Value="15,1,25,1"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- IP address -->
                <DataGridTextColumn Binding="{Binding HostAddress}" Header="IP address" Width="Auto" MinWidth="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Padding" Value="5,1,35,1"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Text" Value="{Binding HostAddress}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HostAddress}" Value="Timed out">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Down.Foreground}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HostAddress}" Value="Invalid hostname">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Down.Foreground}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HostAddress}" Value="0.0.0.0">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Down.Foreground}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Round trip time -->
                <DataGridTextColumn Binding="{Binding RoundTripTime, StringFormat=[{0} ms]}" Header="RTT" Width="*">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Splash.Cyan}"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Padding" Value="5,1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HostAddress}" Value="Timed out">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HostAddress}" Value="Invalid hostname">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HostAddress}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>

        </DataGrid>
    </DockPanel>
</Window>
